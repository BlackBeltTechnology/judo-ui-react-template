import { createContext, useContext, useState, useCallback, useMemo, type ReactNode, type FC } from 'react';

interface ViewContextType {
  getForPage: <T>(key: string) => T;
  setForPage: (key: string, value: any) => void;
  deleteForPage: (key: string) => void;
}

const ViewContext = createContext<ViewContextType | undefined>(undefined);

interface ViewProviderProps {
  children: ReactNode;
}

export const ViewProvider: FC<ViewProviderProps> = ({ children }) => {
  const [data, setData] = useState<Record<string, any>>({});

  const get = useCallback(<T,>(key: string): T => {
    return data[key];
  }, [data]);

  const set = useCallback((key: string, value: any) => {
    setData((prev) => ({ ...prev, [key]: value }));
  }, []);

  const deleteKey = useCallback((key: string) => {
    setData((prev) => {
      const { [key]: _, ...rest } = prev;
      return rest;
    });
  }, []);

  const value = useMemo(
    () => ({ getForPage: get, setForPage: set, deleteForPage: deleteKey }),
    [get, set, deleteKey]
  );

  return (
    <ViewContext.Provider value={value}>
      {children}
    </ViewContext.Provider>
  );
};

export const useViewContext = () => {
  const context = useContext(ViewContext);
  if (context === undefined) {
    throw new Error('useViewContext must be used within a ViewProvider');
  }
  return context;
};
