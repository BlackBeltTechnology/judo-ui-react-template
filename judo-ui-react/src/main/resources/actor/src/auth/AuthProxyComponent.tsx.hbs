import type { FC, ReactNode } from 'react';
import { useBundleContext } from '@pandino/react-hooks';
import { FRAMEWORK_SERVICE_UTILS, type ServiceUtils } from '@pandino/pandino-api';

interface AuthProxyComponentProps {
  filter: string;
  children?: ReactNode;
  [prop: string]: any;
}

export const AuthProxyComponent: FC<AuthProxyComponentProps> = ({ filter, children, ...other }) => {
  {{# if application.authentication }}
  const { bundleContext } = useBundleContext();
  const serviceUtilsRef = bundleContext.getServiceReference<ServiceUtils>(FRAMEWORK_SERVICE_UTILS)!;
  const serviceUtils = bundleContext.getService(serviceUtilsRef)!;
  const refs = bundleContext.getServiceReferences(undefined, filter);
  const ref = serviceUtils.getBestServiceReference(refs);

  if (ref) {
    const ExternalComponent = bundleContext.getService<any>(ref);
    return <ExternalComponent {...other} children={children} />;
  }
  {{/ if }}

  return <>{children}</>;
};
