{{# if child.hiddenBy }} { (actions?.is{{ safeName child }}Hidden ? !actions?.is{{ safeName child }}Hidden(data, editMode) : !data.{{ child.hiddenBy.name }}) && {{/ if }}
<Grid item xs={12} sm={12} {{# neq (calculateSize child) 12.0 }}md={ {{ calculateSize child }} }{{/ neq }}>
    {{# if child.subTheme }}
      <SubThemeWrapper subTheme="{{ child.subTheme }}" data={data}>
    {{/ if }}
    {{# if child.customImplementation }}
        <ComponentProxy
            filter={`(&(${OBJECTCLASS}=${CUSTOM_VISUAL_ELEMENT_INTERFACE_KEY}){{{ attributeBasedComponentProxyFilters child }}})`}
            data={data}
            validation={validation}
            editMode={editMode}
            storeDiff={storeDiff}
            isLoading={isLoading}
            actions={actions}
            boundAttributeName={'{{ child.attributeType.name }}'}
            annotations={[{{# each (getAnnotationNamesForElement child) as |annotation| }}'{{ annotation }}'{{# unless @last}},{{/ unless}}{{/ each }}]}
        >
    {{/ if }}
    <Grid container direction="row" alignItems="center" {{# if child.icon }}spacing={2}{{/ if }}>
        {{# if child.icon }}
            <Grid item>
                <MdiIcon path="{{ child.icon.iconName }}" />
            </Grid>
        {{/ if }}
        <Grid item>
            <Typography id="{{ getXMIID child }}">
                { data.{{ child.attributeType.name }} }
            </Typography>
        </Grid>
    </Grid>
    {{# if child.customImplementation }}
        </ComponentProxy>
    {{/ if }}
    {{# if child.subTheme }}
      </SubThemeWrapper>
    {{/ if }}
</Grid>
{{# if child.hiddenBy }} } {{/ if }}
