{{# if child.hiddenBy }} { (actions?.is{{ safeName child }}Hidden ? !actions?.is{{ safeName child }}Hidden(data, editMode) : !data.{{ child.hiddenBy.name }}) && {{/ if }}
<Grid size={ { xs: 12, sm: 12{{# neq (calculateSize child) 12.0 }}, md: {{ calculateSize child }}{{/ neq }} } }>
    {{# if child.subTheme }}
      <SubThemeWrapper subTheme="{{ child.subTheme }}" data={data}>
    {{/ if }}
    {{# if child.customImplementation }}
        <ComponentProxy
            filter={`(&(${OBJECTCLASS}=${CUSTOM_VISUAL_ELEMENT_INTERFACE_KEY}){{{ attributeBasedComponentProxyFilters child }}})`}
            data={data}
            validation={validation}
            editMode={editMode}
            storeDiff={storeDiff}
            isLoading={isLoading}
            actions={actions}
            boundAttributeName={'{{ child.attributeType.name }}'}
            annotations={[{{# each (getAnnotationNamesForElement child) as |annotation| }}'{{ annotation }}'{{# unless @last}},{{/ unless}}{{/ each }}]}
        >
    {{/ if }}
    {{# if (hasTooltipText child) }}
    <Box display="flex" alignItems="center">
    {{/ if }}
    <DateTimePicker
        // MUI X's accessible field structure renders the editor as a contenteditable
        // section list and hides the value in a 1x1 input, so the canonical
        // field::<id>::input role would address something nothing can be typed or
        // pasted into. A date field keeps the single-input structure instead.
        enableAccessibleFieldDOMStructure={false}
        data-testid={buildFieldTestId('{{ getElementId child }}')}
        ampm={false}
        ampmInClock={false}
        className={ clsx({
            'JUDO-viewMode': !editMode,
            'JUDO-required': {{ boolValue child.attributeType.isRequired }},
        }) }
        {{# if (shouldElementHaveAutoFocus child) }}
            inputRef={autoFocusInputRef}
        {{/ if }}
        slotProps={ {
            textField: {
                id: '{{ getXMIID child }}',
                required: actions?.is{{ firstToUpper child.attributeType.name }}Required ? actions.is{{ firstToUpper child.attributeType.name }}Required(data, editMode) : ({{# if child.requiredBy }}data.{{ child.requiredBy.name }} ||{{/ if }} {{ boolValue child.attributeType.isRequired  }}),
                helperText: validation.get('{{ child.attributeType.name }}'),
                error: !!validation.get('{{ child.attributeType.name }}'),
                InputLabelProps: { shrink: true },
                {{# if child.icon }}
                    InputProps: {
                        startAdornment: (
                            <InputAdornment position="start">
                                <MdiIcon path="{{ child.icon.iconName }}" />
                            </InputAdornment>
                        ),
                    },
                {{/ if }}
            },
            actionBar: {
              actions: ['today', 'accept'],
            },
        } }
        onError={ (newError: DateTimeValidationError, value: any) => {
            // https://mui.com/x/react-date-pickers/validation/#show-the-error
            setValidation((prevValidation) => {
                const copy = new Map<keyof {{ classDataName container.dataElement '' }}, string>(prevValidation);
                if (newError === 'invalidDate') {
                  copy.set(
                    '{{ child.attributeType.name }}',
                    (t('judo.error.validation-failed.PATTERN_VALIDATION_FAILED', {
                      defaultValue: 'Value does not match the pattern requirements.',
                    }) as string),
                  );
                }{{# if child.minValueBy }} else if (newError === 'minDate' && data.{{ child.minValueBy.name }}) {
                  copy.set(
                    '{{ child.attributeType.name }}',
                    (t('judo.error.validation-failed.MIN_DATE_VALIDATION_FAILED', {
                      defaultValue: 'The selected timestamp must be after the minimum allowed timestamp.',
                      minDate: new Intl.DateTimeFormat(l10nLocale, { year: 'numeric', month: '2-digit', day: '2-digit' }).format(data.{{ child.minValueBy.name }})
                    }) as string),
                  );
                }{{/ if }} {{# if child.maxValueBy }} else if (newError === 'maxDate' && data.{{ child.maxValueBy.name }}) {
                  copy.set(
                    '{{ child.attributeType.name }}',
                    (t('judo.error.validation-failed.MAX_DATE_VALIDATION_FAILED', {
                      defaultValue: 'The selected timestamp must be before the maximum allowed timestamp.',
                      maxDate: new Intl.DateTimeFormat(l10nLocale, { year: 'numeric', month: '2-digit', day: '2-digit' }).format(data.{{ child.maxValueBy.name }})
                    }) as string),
                  );
                }{{/ if }} {{# if child.minValueBy }} else if (newError === 'minTime' && data.{{ child.minValueBy.name }}) {
                  copy.set(
                    '{{ child.attributeType.name }}',
                    (t('judo.error.validation-failed.MIN_TIME_VALIDATION_FAILED', {
                      defaultValue: 'The selected timestamp must be after the minimum allowed timestamp.',
                      minTime: new Intl.DateTimeFormat(l10nLocale, { hour: '2-digit', minute: '2-digit', second: '2-digit' }).format(data.{{ child.minValueBy.name }})
                    }) as string),
                  );
                }{{/ if }} {{# if child.maxValueBy }} else if (newError === 'maxTime' && data.{{ child.maxValueBy.name }}) {
                  copy.set(
                    '{{ child.attributeType.name }}',
                    (t('judo.error.validation-failed.MAX_TIME_VALIDATION_FAILED', {
                      defaultValue: 'The selected timestamp must be before the maximum allowed timestamp.',
                      maxTime: new Intl.DateTimeFormat(l10nLocale, { hour: '2-digit', minute: '2-digit', second: '2-digit' }).format(data.{{ child.maxValueBy.name }})
                    }) as string),
                  );
                }{{/ if }} else {
                  copy.set('{{ child.attributeType.name }}', '');
                }
                return copy;
            });
        } }
        views={['year', 'month', 'day', 'hours', 'minutes', 'seconds']}
        label={ t('{{ getTranslationKeyForVisualElement child }}', { defaultValue: '{{ child.label }}' }) as string }
        value={ data.{{ child.attributeType.name }} ?? null }
        readOnly={actions?.is{{ firstToUpper child.attributeType.name }}Readonly ? actions.is{{ firstToUpper child.attributeType.name }}Readonly(data, editMode, isLoading) : ({{ boolValue child.attributeType.isReadOnly }} || !isFormUpdateable())}
        disabled={actions?.is{{ firstToUpper child.attributeType.name }}Disabled ? actions.is{{ firstToUpper child.attributeType.name }}Disabled(data, editMode, isLoading) : ({{# if child.enabledBy }}!data.{{ child.enabledBy.name }} ||{{/ if }} isLoading)}
        onChange={ (newValue: Date | null) => {
            storeDiff('{{ child.attributeType.name }}', newValue);
            {{# if child.onBlur }}
            if (actions?.on{{ firstToUpper child.attributeType.name }}BlurAction) {
                const eagerCopy = { ...data, ['{{ child.attributeType.name }}']: newValue{{# if child.attributeType.isRequired }}!{{/ if }} };
                actions.on{{ firstToUpper child.attributeType.name }}BlurAction(eagerCopy, storeDiff, editMode, submit);
            }
            {{/ if }}
        } }
        {{# unless child.isReadOnly }}
        {...(actions.get{{ firstToUpper child.attributeType.name }}ValidationProps ? actions.get{{ firstToUpper child.attributeType.name }}ValidationProps(data) : {
            {{# if child.minValueBy }}
              minDateTime: data?.{{ child.minValueBy.name }} ?? undefined,
            {{/if}}
            {{# if child.maxValueBy }}
              maxDateTime: data?.{{ child.maxValueBy.name }} ?? undefined,
            {{/if}}
        })}
        {{/ unless }}
    />
    {{# if (hasTooltipText child) }}
      {{> actor/src/fragments/container/input-tooltip.fragment.hbs input=child }}
    </Box>
    {{/ if }}
    {{# if child.customImplementation }}
        </ComponentProxy>
    {{/ if }}
    {{# if child.subTheme }}
      </SubThemeWrapper>
    {{/ if }}
</Grid>
{{# if child.hiddenBy }} } {{/ if }}
