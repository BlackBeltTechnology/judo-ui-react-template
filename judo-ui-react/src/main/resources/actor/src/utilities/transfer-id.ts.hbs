import { draftIdentifierPrefix } from '~/services/data-api/common/utils';

/**
 * Unified transfer-object identity contract shared with judo-frontend-runtime.
 *
 * See `openspec/specs/transfer-identity/spec.md` for the normative contract.
 *
 * All row-key resolution, new-row seeding, and `data-testid` construction in
 * the generated app MUST go through these helpers so that Playwright tests
 * written against the runtime output pass against the template output.
 */

/** Loose shape of any transfer object we may need to identify. */
export interface TransferIdSource {
  __signedIdentifier?: string;
  __identifier?: string;
  __tempId?: string;
  __isNew?: boolean;
  id?: string | number;
}

/**
 * Resolve the client-side identity of a transfer object. Never throws, never
 * returns undefined. Matches the runtime's fallback chain exactly:
 *
 *   __signedIdentifier ?? __identifier ?? __tempId ?? id ?? `idx-${index}`
 */
export function resolveTransferId(row: TransferIdSource | undefined | null, index?: number): string {
  if (!row) {
    return typeof index === 'number' ? `idx-${index}` : 'idx-undefined';
  }
  if (typeof row.__signedIdentifier === 'string' && row.__signedIdentifier.length > 0) {
    return row.__signedIdentifier;
  }
  if (typeof row.__identifier === 'string' && row.__identifier.length > 0) {
    return row.__identifier;
  }
  if (typeof row.__tempId === 'string' && row.__tempId.length > 0) {
    return row.__tempId;
  }
  if (row.id !== undefined && row.id !== null && `${row.id}`.length > 0) {
    return `${row.id}`;
  }
  return typeof index === 'number' ? `idx-${index}` : 'idx-undefined';
}

/**
 * Produce a fresh temp id for a client-created, not-yet-saved row.
 * Format: `temp::<ms-since-epoch>::<7-hex-chars>`.
 * Matches the runtime's format from dataid-template-runtime.pdf §3.
 */
export function newTempId(): string {
  const rand = Math.floor(Math.random() * 0x10000000)
    .toString(16)
    .padStart(7, '0')
    .slice(0, 7);
  return `temp::${Date.now()}::${rand}`;
}

/**
 * Classify whether a row is a client-created, not-yet-saved row.
 *
 * Primary check: `__isNew === true` (aligned with the runtime).
 *
 * Compatibility rung: also returns true when `__identifier` still carries
 * the legacy `draft:` prefix seeded by Phase-1's serializer
 * (`judo-ui-typescript-rest-template/.../rest/serializer.ts.hbs`). Remove
 * this rung once Phase-1 stops emitting the prefix (follow-up JIRA).
 */
export function isNewRow(row: TransferIdSource | undefined | null): boolean {
  if (!row) return false;
  if (row.__isNew === true) return true;
  // TODO(JNG-6391 follow-up): remove after Phase-1 draft-seed is retired.
  if (typeof row.__identifier === 'string' && row.__identifier.startsWith(draftIdentifierPrefix)) {
    return true;
  }
  return false;
}

/**
 * Loose id type accepted by every `build*TestId` helper. MUI's `GridRowId`
 * is `string | number`; some optional widget `id` props are `string | undefined`.
 * The helpers coerce to a stable string and fall back to `'unknown'` for
 * missing values, so tests never crash on a bad id.
 */
type TestIdKey = string | number | undefined | null;

function stringifyKey(key: TestIdKey): string {
  return key === undefined || key === null || key === '' ? 'unknown' : String(key);
}

/**
 * Build a hierarchical `data-testid` value for a field-level widget node.
 * `role` is drawn from the vocabulary in `openspec/specs/transfer-identity/spec.md`.
 */
export function buildFieldTestId(xmiId: TestIdKey, role?: string): string {
  const key = stringifyKey(xmiId);
  return role ? `field::${key}::${role}` : `field::${key}`;
}

export function buildButtonTestId(buttonId: TestIdKey, actionType?: string): string {
  const key = stringifyKey(buttonId);
  return actionType ? `button::${key}::${actionType}` : `button::${key}`;
}

/** Build the outer `data-testid` for a table. */
export function buildTableTestId(tableId: TestIdKey): string {
  return `table::${stringifyKey(tableId)}`;
}

/** Build the `data-testid` for a table's column header (the sort handle). */
export function buildColumnHeaderTestId(tableId: TestIdKey, columnName: string): string {
  return `table::${stringifyKey(tableId)}::header::${columnName}`;
}

/** Build the `data-testid` for a specific row in a table. */
export function buildRowTestId(tableId: TestIdKey, row: TransferIdSource | undefined | null, index?: number): string {
  return `table::${stringifyKey(tableId)}::row::${resolveTransferId(row, index)}`;
}

/** Build the `data-testid` for a specific cell in a table. */
export function buildCellTestId(
  tableId: TestIdKey,
  row: TransferIdSource | undefined | null,
  columnName: string,
  index?: number,
): string {
  return `table::${stringifyKey(tableId)}::row::${resolveTransferId(row, index)}::cell::${columnName}`;
}

/**
 * Reserved row-action role for the overflow ("more actions") dropdown trigger. It has no model
 * action behind it, so no role can be derived for it; both engines agree on this literal.
 */
export const ROW_ACTION_ROLE_OVERFLOW = 'overflow';

/**
 * Reserved row-action roles for the inline-edit controls. These are UI-only pseudo-actions with no
 * model action definition, so the runtime currently emits nothing for them (see this change's design
 * OQ1). They are template-only until the runtime adopts them.
 */
export const ROW_ACTION_ROLE_EDIT = 'edit';
export const ROW_ACTION_ROLE_SAVE = 'save';
export const ROW_ACTION_ROLE_CANCEL = 'cancel';

/**
 * Build the `data-testid` for a row-scoped action button.
 * Runtime parity: `table::<tableId>::row::<transferId>::action::<role>`.
 *
 * `role` comes from the canonical role vocabulary (`set` | `create` | `view` | `delete` | any raw
 * action type, plus the reserved `overflow`, `edit`, `save`, `cancel` literals). A missing or
 * `unknown` role is a generator bug rather than a runtime condition, so it throws instead of
 * emitting an unaddressable id.
 */
export function buildRowActionTestId(
  tableId: TestIdKey,
  row: TransferIdSource | undefined | null,
  role: string,
  index?: number,
): string {
  if (!role || role === 'unknown') {
    throw new Error(`buildRowActionTestId requires a canonical action role, received '${role}'.`);
  }
  return `${buildRowTestId(tableId, row, index)}::action::${role}`;
}

/** Build the `data-testid` for the selection (checkbox) cell of a row. */
export function buildSelectionCellTestId(
  tableId: TestIdKey,
  row: TransferIdSource | undefined | null,
  index?: number,
): string {
  // MUI's selection column always uses the `__check__` field name, so this is the ordinary cell id.
  return buildCellTestId(tableId, row, '__check__', index);
}

/** Build the `data-testid` for a table's filter panel. Runtime parity: `table::<id>::filter-panel`. */
export function buildFilterPanelTestId(tableId: TestIdKey): string {
  return `${buildTableTestId(tableId)}::filter-panel`;
}

/** Build the `data-testid` for the filter panel's column selector. */
export function buildFilterPanelColumnInputTestId(tableId: TestIdKey): string {
  return `${buildFilterPanelTestId(tableId)}::column`;
}

/**
 * Build the `data-testid` for one filter row of the panel.
 *
 * Several rows may filter the same attribute (`name LIKE x` AND
 * `name NOT_EQUAL y`), so the row index is the only stable disambiguator —
 * the attribute name is not unique. Runtime parity:
 * `table::<id>::filter-panel::row::<n>`.
 */
export function buildFilterPanelRowTestId(tableId: TestIdKey, index: number): string {
  return `${buildFilterPanelTestId(tableId)}::row::${index}`;
}

/**
 * Build the `data-testid` for a filter panel's operator selector.
 *
 * Pass `index` to scope the role to that filter row; omit it for the
 * single-row panel form.
 */
export function buildFilterPanelOperatorInputTestId(tableId: TestIdKey, index?: number): string {
  const scope = index === undefined ? buildFilterPanelTestId(tableId) : buildFilterPanelRowTestId(tableId, index);
  return `${scope}::operator`;
}

/**
 * Build the `data-testid` for a filter panel's value input.
 *
 * Pass `index` to scope the role to that filter row; omit it for the
 * single-row panel form.
 */
export function buildFilterPanelValueInputTestId(tableId: TestIdKey, index?: number): string {
  const scope = index === undefined ? buildFilterPanelTestId(tableId) : buildFilterPanelRowTestId(tableId, index);
  return `${scope}::value`;
}

/**
 * Build the `data-testid` for one operator option of a filter row.
 *
 * `operation` is the backend filter operator (`like`, `equal`, `notEqual`,
 * `matches`, `lessThan`, …), never the translated label, so an engine-neutral
 * spec can pick an operator regardless of the UI language.
 */
export function buildFilterPanelOperatorOptionTestId(
  tableId: TestIdKey,
  index: number,
  operation: string,
): string {
  return `${buildFilterPanelOperatorInputTestId(tableId, index)}::${operation}`;
}

// ---------------------------------------------------------------------------
// Domain-prefixed testid helpers.
//
// Grammar and role vocabulary mirror the runtime's @judo/test-ids package:
//   dialog     ← packages/test-ids/src/dialog.ts
//   navigation ← packages/test-ids/src/navigation.ts
//   tabs       ← packages/test-ids/src/tabs.ts
// ---------------------------------------------------------------------------

/** Build the outer `data-testid` for a dialog. Runtime parity: `dialog::<id>`. */
export function buildDialogTestId(dialogId: TestIdKey): string {
  return `dialog::${stringifyKey(dialogId)}`;
}

/**
 * Build a role-suffixed `data-testid` inside a dialog.
 * Role vocabulary: `title` | `content` | `actions` | `close` | `confirm` | `cancel`.
 * Callers MAY nest compound roles with `::`.
 */
export function buildDialogRoleTestId(dialogId: TestIdKey, role: string): string {
  return `dialog::${stringifyKey(dialogId)}::${role}`;
}

/** Build the outer `data-testid` for a tab controller. Runtime parity: `tabs::<ctrlId>`. */
export function buildTabControllerTestId(ctrlId: TestIdKey): string {
  return `tabs::${stringifyKey(ctrlId)}`;
}

/** Build a per-tab `data-testid`. Runtime parity: `tabs::<ctrlId>::<tabId>`. */
export function buildTabTestId(ctrlId: TestIdKey, tabId: TestIdKey): string {
  return `tabs::${stringifyKey(ctrlId)}::${stringifyKey(tabId)}`;
}

/** Build a tab-panel `data-testid`. Runtime parity: `tabs::<ctrlId>::<tabId>::panel`. */
export function buildTabPanelTestId(ctrlId: TestIdKey, tabId: TestIdKey): string {
  return `tabs::${stringifyKey(ctrlId)}::${stringifyKey(tabId)}::panel`;
}

/** Build the tab-list `data-testid`. Runtime parity: `tabs::<ctrlId>::list`. */
export function buildTabListTestId(ctrlId: TestIdKey): string {
  return `tabs::${stringifyKey(ctrlId)}::list`;
}

/**
 * Compose a nav-item path segment. Root menus pass `parentPath=undefined`;
 * each nested nav component threads its own path down to children.
 *
 *   buildNavItemPath(undefined, 'root')          → 'root'
 *   buildNavItemPath('root', 'settings')         → 'root::settings'
 *   buildNavItemPath('root::settings', 'prefs')  → 'root::settings::prefs'
 */
export function buildNavItemPath(parentPath: string | undefined, currentId: TestIdKey): string {
  const key = stringifyKey(currentId);
  return parentPath && parentPath.length > 0 ? `${parentPath}::${key}` : key;
}

/**
 * Build the outer `data-testid` for a nav item, optionally nested under a parent path.
 * Runtime parity: `nav::item::<path>`.
 */
export function buildNavItemTestId(itemId: TestIdKey, parentPath?: string): string {
  return `nav::item::${buildNavItemPath(parentPath, itemId)}`;
}

/**
 * Build a role-suffixed `data-testid` under a nav item.
 * Role vocabulary: `icon` | `label` | `expand`.
 */
export function buildNavItemRoleTestId(navItemTestId: string, role: string): string {
  return `${navItemTestId}::${role}`;
}

/** Build the `data-testid` for a breadcrumb item at a given index. Runtime parity: `breadcrumb::<index>`. */
export function buildBreadcrumbTestId(index: number): string {
  return `breadcrumb::${index}`;
}
