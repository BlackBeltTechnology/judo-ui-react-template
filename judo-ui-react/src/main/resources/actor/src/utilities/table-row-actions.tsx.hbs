import type { ReactNode } from 'react';

export interface TableRowAction<R, RStored> {
  id: string;
  /**
   * Canonical action role for the row-action button's `data-testid`.
   * `edit`, `save`, and `cancel` are template-only reserved roles until the runtime adopts them.
   * Downstream overrides that set this field must now provide a role, not a free-form button suffix.
   */
  testId?: string;
  /** Raw action type used by the standalone button grammar when no role is available. */
  actionType?: string;
  label?: string;
  action?: (row: RStored) => Promise<void>;
  icon?: ReactNode;
  tooltip?: string;
  hidden: (row: RStored) => boolean;
  disabled: (
    row: RStored,
    isLoading: boolean,
    isRowInEditMode: boolean,
    getSelectedRows: () => R[],
    ownerData?: any,
  ) => boolean,
  disabledExpression?: string;
  isCRUD?: boolean;
  isEditAction?: boolean;
}

export interface ColumnsActionsOptions {
  crudOperationsDisplayed?: number;
  transferOperationsDisplayed?: number;
  actionsColumnWidth?: number;
}
