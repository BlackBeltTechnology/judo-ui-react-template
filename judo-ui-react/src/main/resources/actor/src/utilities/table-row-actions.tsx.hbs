import type { ReactNode } from 'react';

export interface TableRowAction<R, RStored> {
  id: string;
  /**
   * Optional role suffix for the row-action button's `data-testid`. When set,
   * the emitted testid is `...::button::<testId>` (e.g. `edit`/`save`/`cancel`);
   * otherwise it falls back to the full `id`. See `~/utilities/transfer-id`.
   */
  testId?: string;
  label?: string;
  action?: (row: RStored) => Promise<void>;
  icon?: ReactNode;
  tooltip?: string;
  hidden: (row: RStored) => boolean;
  disabled: (
    row: RStored,
    isLoading: boolean,
    isRowInEditMode: boolean,
    getSelectedRows: () => R[],
    ownerData?: any,
  ) => boolean,
  disabledExpression?: string;
  isCRUD?: boolean;
  isEditAction?: boolean;
}

export interface ColumnsActionsOptions {
  crudOperationsDisplayed?: number;
  transferOperationsDisplayed?: number;
  actionsColumnWidth?: number;
}
