/**
 * Browser-state namespacing.
 *
 * Two JUDO frontend applications of the same model can be served from one origin on distinct base
 * paths (for example `/{{ application.modelName }}/{{ application.name }}/` and
 * `/{{ application.modelName }}_runtime/{{ application.name }}/`). Because `localStorage` and
 * `sessionStorage` are scoped to the origin, not to the path, unprefixed keys would be shared and the
 * two applications would overwrite each other's session, locale and layout state.
 *
 * Every persisted key is therefore prefixed with a namespace derived from the base path this
 * application is actually served on, so the namespace is automatically correct in production, in
 * single-actor mode (where one application owns the root path), and in development.
 *
 * This convention is shared with the model-driven runtime frontend (`@judo/core`'s
 * `namespacedStorageKey`) and the two must stay in agreement.
 */

/** Prefix that identifies a namespaced JUDO storage key. */
const STORAGE_KEY_PREFIX = 'judo';

/** Namespace used when the application is served from the origin root. */
const ROOT_NAMESPACE = 'root';

/**
 * Derives the storage namespace from a base path. Leading and trailing slashes are dropped and
 * remaining slashes become dots, so `/{{ application.modelName }}/{{ application.name }}/` becomes
 * `{{ application.modelName }}.{{ application.name }}` and `/` becomes `root`.
 */
export function deriveStorageNamespace(basePath: string): string {
  const trimmed = basePath.replace(/^\/+/, '').replace(/\/+$/, '');
  if (trimmed === '') {
    return ROOT_NAMESPACE;
  }
  return trimmed.replace(/\/+/g, '.');
}

/**
 * Resolves the storage namespace of the running application from the document base URI, falling back
 * to the root namespace outside a browser.
 */
export function getStorageNamespace(): string {
  if (typeof document === 'undefined') {
    return ROOT_NAMESPACE;
  }
  try {
    return deriveStorageNamespace(new URL(document.baseURI).pathname);
  } catch {
    return ROOT_NAMESPACE;
  }
}

/**
 * The prefix every persisted key of this application carries, including its trailing separator.
 */
export function getStorageKeyPrefix(namespace: string = getStorageNamespace()): string {
  return `${STORAGE_KEY_PREFIX}:${namespace}:`;
}

/**
 * Namespaces a single storage key, for example `judo:{{ application.modelName }}.{{ application.name }}:oidc.user:...`.
 */
export function namespacedStorageKey(key: string, namespace: string = getStorageNamespace()): string {
  return `${getStorageKeyPrefix(namespace)}${key}`;
}

/**
 * Removes only this application's entries from a storage area, leaving a sibling frontend's state on
 * the same origin intact.
 */
export function clearNamespacedStorage(storage: Storage): void {
  const prefix = getStorageKeyPrefix();
  const keys: string[] = [];
  for (let index = 0; index < storage.length; index++) {
    const key = storage.key(index);
    if (key !== null && key.startsWith(prefix)) {
      keys.push(key);
    }
  }
  keys.forEach((key) => storage.removeItem(key));
}
