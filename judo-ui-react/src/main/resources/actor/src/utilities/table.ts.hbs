export const TABLE_COLUMN_CUSTOMIZER_HOOK_INTERFACE_KEY = 'TABLE_COLUMN_CUSTOMIZER_HOOK_INTERFACE_KEY';

export type ColumnCustomizerHook<T extends JudoStored<T>> = () => ColumnCustomizer<T>;
export type ColumnCustomizer<T extends JudoStored<T>> = (original: GridColDef<T>) => GridColDef<T>;


export function calculateActionName(relationName: string, actionName: string) {
  if (relationName === '') {
    return actionName;
  } else {
    return relationName + actionName.charAt(0).toUpperCase() + actionName.slice(1);
  }
}

export const isRowSelectable = <T extends JudoStored<T>>(row: T & { __selected?: boolean }, single?: boolean, alreadySelectedItems?: T[]) => {
  if (Array.isArray(alreadySelectedItems) && alreadySelectedItems.length) {
    // This branch should be used by aggregation tables because in these cases callers would pass their in-memory
    // item list which we need to check.
    return !alreadySelectedItems.find(i => i.__identifier === row.__identifier);
  } else if (!single || typeof row?.__selected === 'boolean') {
    // This branch should be used by association table relations which trigger instantly and always have to check the
    // backend state.
    return !row.__selected;
  }
  // This case is for single aggregations, because users can unset the element in edit mode but would not be able to
  // re-set them if we checked the backend response above (since the removal might not be persisted yet).
  return true;
};

// Helper functions for MUI X Data Grid v8 GridRowSelectionModel
export const createEmptySelectionModel = (): GridRowSelectionModel => ({
  type: 'include',
  ids: new Set(),
});

export const selectionModelToArray = (selectionModel: GridRowSelectionModel): any[] => {
  return [...selectionModel.ids];
};

export const arrayToSelectionModel = (ids: any[]): GridRowSelectionModel => ({
  type: 'include',
  ids: new Set(ids),
});

export const selectionModelSize = (selectionModel: GridRowSelectionModel): number => {
  return selectionModel.ids.size;
};

export const selectionModelHas = (selectionModel: GridRowSelectionModel, id: any): boolean => {
  return selectionModel.ids.has(id);
};

export const getUpdatedRowsSelected = (selectedRows: MutableRefObject<any[]>, data: any[], selectionModel: GridRowSelectionModel): any[] => {
  const newSelectedRows: any[] = [];
  // if we are dealing with transient items, we give up...
  // our source of truth is the `selectionModel`
  for (const selection of selectionModel.ids) {
    const prevItem = selectedRows.current.length && selectedRows.current[0].__identifier ? selectedRows.current.find((r) => r.__identifier === selection) : undefined;
    if (prevItem) {
      // we already have the item in our `selectedRows`, so keep it
      newSelectedRows.push(prevItem);
    } else {
      // `selection` is a new key, we need to look up the row data in our `data`
      const newItem = data.length && data[0].__identifier ? data.find((r) => r.__identifier === selection) : undefined;
      if (newItem) {
        // and add it if found
        newSelectedRows.push(newItem);
      }
    }
  }

  // since we created a new whitelist of selections, removed selections are left out
  return newSelectedRows;
};

// Column virtualisation would drop off-screen pinned columns from the DOM.
// ponytail: tables are paged (5-50 rows), so a large buffer is cheap; measure before lowering it.
export const pinnedColumnBufferPx = 10000;

export interface PinnedColumns {
  left?: string[];
  right?: string[];
}

const withClass = <P,>(original: string | ((params: P) => string) | undefined, extra: string) =>
  typeof original === 'function' ? (params: P) => `${original(params)} ${extra}` : original ? `${original} ${extra}` : extra;

// Column pinning without MUI Pro. The community grid already styles its pinned classes (sticky, opaque theme
// background, hover/selected), so pinned columns get those classes plus a sticky offset: the summed widths of
// the pinned columns between the column and its edge, in column order. `actions` is always the outermost right column.
// ponytail: columns without a fixed width use MUI's default (100); add flex support when a pinned flex column shows up.
export const pinColumns = <T extends GridValidRowModel>(
  columns: GridColDef<T>[],
  pinned: PinnedColumns,
): { columns: GridColDef<T>[]; sx: Record<string, object> } => {
  const sides = new Map<string, 'left' | 'right'>();
  (pinned.left ?? []).forEach((f) => sides.set(f, 'left'));
  [...(pinned.right ?? []), 'actions'].forEach((f) => sides.set(f, 'right'));

  const sx: Record<string, object> = {};
  const place = (cols: GridColDef<T>[], side: 'left' | 'right') => {
    let offset = 0;
    for (const c of cols) {
      if (sides.get(c.field) !== side) continue;
      sx[`& [data-field="${c.field}"]`] = { [side]: offset };
      offset += c.width ?? c.minWidth ?? 100;
    }
  };
  place(columns, 'left');
  place([...columns].reverse(), 'right');

  return {
    sx,
    columns: columns.map((c) => {
      const side = sides.get(c.field);
      if (!side) return c;
      const suffix = side === 'left' ? 'Left' : 'Right';
      return {
        ...c,
        cellClassName: withClass(c.cellClassName, `MuiDataGrid-cell--pinned${suffix}`),
        headerClassName: withClass(c.headerClassName, `MuiDataGrid-columnHeader--pinned${suffix}`),
      };
    }),
  };
};
