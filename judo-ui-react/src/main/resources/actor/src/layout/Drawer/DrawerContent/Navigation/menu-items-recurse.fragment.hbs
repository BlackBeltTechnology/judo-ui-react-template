{
    id: '{{ createId item }}',
    type: '{{ getMenuType item isRoot }}',
    {{# unless (isNavItemAGroup item) }}
        {{# if item.target.openInDialog }}
            onClick: () => open{{ pageName item.target }}({ ownerData: null as any }),
        {{ else }}
            url: '{{ getPageRoute item.target }}',
        {{/if}}
    {{/ unless }}
    {{# if item.icon }}
        icon: '{{ item.icon.iconName }}',
    {{/ if }}
    {{# if item.label }}
        title: '{{ item.label }}',
    {{/ if }}
    {{# if item.hiddenBy }}
        hiddenBy: '{{ item.hiddenBy }}',
    {{/ if }}
    {{# if item.actionDefinition }}
        onClick: {{ simpleActionDefinitionName item.actionDefinition }},
    {{/ if }}
    children: [
        {{# each item.items as |subItem| }}
            {{> actor/src/layout/Drawer/DrawerContent/Navigation/menu-items-recurse.fragment.hbs item=subItem isRoot=false }}
        {{/ each }}
    ],
},
