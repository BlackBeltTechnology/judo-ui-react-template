{{> fragment.header.hbs }}

import Divider from '@mui/material/Divider';
import Grid from '@mui/material/Grid';
import IconButton from '@mui/material/IconButton';
import List from '@mui/material/List';
import Popover from '@mui/material/Popover';
import Button from '@mui/material/Button';
import { THEME_ID } from '@mui/material';
import Tooltip from '@mui/material/Tooltip';
import Avatar from '@mui/material/Avatar';
import Box from '@mui/material/Box';
import ButtonBase from '@mui/material/ButtonBase';
import ClickAwayListener from '@mui/material/ClickAwayListener';
import Paper from '@mui/material/Paper';
import Stack from '@mui/material/Stack';
import TextField from '@mui/material/TextField';
import Typography from '@mui/material/Typography';
import { useTheme } from '@mui/material/styles';
import { useCallback, useRef, useState, useMemo } from 'react';
import { useTranslation } from 'react-i18next';
import { MdiIcon, useJudoNavigation } from '~/components';
import { DRAWER_WIDTH, MINI_DRAWER_WIDTH, PaletteColorKey, ThemeMode } from '~/config';
import { useConfig, useDemoFeature, useHeroProps } from '~/hooks';
import { ProfilePopup } from '~/layout/ProfilePopup';
{{# if application.authentication }}
  import { useAuth } from 'react-oidc-context';
  {{# if application.profilePage }}
    import type { JudoIdentifiable } from '~/services/data-api/common/JudoIdentifiable';
    import { judoAxiosProvider } from '~/services/data-axios/JudoAxiosProvider';
    import { {{ getServiceClassForPage application.profilePage }} } from '~/services/data-axios/{{ getServiceClassForPage application.profilePage }}';
    {{# if application.profilePage.openInDialog }}
      import { use{{ pageName application.profilePage }} } from '~/dialogs/{{ pagePath application.profilePage }}';
    {{ else }}
      import { {{ calculateNavigationRoute application.profilePage }} } from '~/routes';
    {{/ if }}
  {{/ if }}
{{/ if }}


import { useLayoutHelper } from '~/utilities/layout-helper';

export const DrawerProfile = () => {
  const { t } = useTranslation();
  const theme = useTheme();
  const heroProps = useHeroProps();
  const { downLG } = useLayoutHelper();
  const anchorRef = useRef<any>(null);
  const paletteAnchorRef = useRef<HTMLButtonElement>(null);
  const [open, setOpen] = useState(false);
  const [paletteOpen, setPaletteOpen] = useState(false);
  const isDemoEnabled = useDemoFeature();
  const { miniDrawer, mode, onChangeMode, onChangePaletteColor, onResetPaletteColors } = useConfig();

  {{# if application.authentication }}
    {{# if application.profilePage }}
      const {{ firstToLower (getServiceImplForPage application.profilePage) }} = useMemo(() => new {{ getServiceClassForPage application.profilePage }}(judoAxiosProvider), []);
      {{# if application.profilePage.openInDialog }}
        const getSingletonPayload = async (): Promise<JudoIdentifiable<any>> => {
          const { data: sp } = await {{ firstToLower (getServiceImplForPage application.profilePage) }}.refreshFor{{ firstToUpper application.profilePage.dataElement.name }}({
            _mask: '{}',
          });
          return sp;
        }
        const open{{ pageName application.profilePage }} = use{{ pageName application.profilePage }}();
        const openProfilePage = async () => {
          const profileData = await getSingletonPayload();
          setOpen(false);
          await open{{ pageName application.profilePage }}(profileData);
        };
      {{ else }}
        const { navigate } = useJudoNavigation();
        const openProfilePage = async () => {
          setOpen(false);
          navigate(routeTo{{ pageName application.profilePage }}());
        };
      {{/ if }}
    {{/ if }}
    const { signoutRedirect, isAuthenticated } = useAuth();
    const doLogout = useCallback(() => {
      const redirectUrl = window.location.href.split('#')[0];
      signoutRedirect({
        post_logout_redirect_uri: redirectUrl,
      });
    }, [isAuthenticated]);
  {{/ if }}

  const handleToggle = (event: React.MouseEvent<HTMLElement>) => {
    setOpen((prevOpen) => !prevOpen);
  };

  const handleClose = (event: MouseEvent | TouchEvent) => {
    if (anchorRef.current && anchorRef.current.contains(event.target)) {
      return;
    }
    setOpen(false);
  };

  const handleToggleThememode = (event: React.MouseEvent<HTMLElement>) => {
    if (mode == ThemeMode.DARK) {
      onChangeMode(ThemeMode.LIGHT);
    } else {
      onChangeMode(ThemeMode.DARK);
    }
  };

  const handleTogglePalette = () => {
    setPaletteOpen((isOpen) => !isOpen);
  };

  const handleClosePalette = () => {
    setPaletteOpen(false);
  };

  const paletteColors: { key: PaletteColorKey; label: string; value: string }[] = [
    { key: 'primary', label: t('judo.profile.palette.primary', { defaultValue: 'Primary' }), value: theme.palette.primary.main },
    { key: 'secondary', label: t('judo.profile.palette.secondary', { defaultValue: 'Secondary' }), value: theme.palette.secondary.main },
    { key: 'error', label: t('judo.profile.palette.error', { defaultValue: 'Error' }), value: theme.palette.error.main },
    { key: 'warning', label: t('judo.profile.palette.warning', { defaultValue: 'Warning' }), value: theme.palette.warning.main },
    { key: 'info', label: t('judo.profile.palette.info', { defaultValue: 'Info' }), value: theme.palette.info.main },
    { key: 'success', label: t('judo.profile.palette.success', { defaultValue: 'Success' }), value: theme.palette.success.main },
    { key: 'textPrimary', label: t('judo.profile.palette.textPrimary', { defaultValue: 'Text primary' }), value: theme.palette.text.primary },
    { key: 'textSecondary', label: t('judo.profile.palette.textSecondary', { defaultValue: 'Text secondary' }), value: theme.palette.text.secondary },
    { key: 'subtitleColor', label: t('judo.profile.palette.subtitle', { defaultValue: 'Subtitle' }), value: theme.palette.subtitleColor.main },
    { key: 'backgroundDefault', label: t('judo.profile.palette.background', { defaultValue: 'Background' }), value: theme.palette.background.default },
    { key: 'backgroundPaper', label: t('judo.profile.palette.paper', { defaultValue: 'Paper' }), value: theme.palette.background.paper },
  ];

  const getColorInputValue = (color: string) => (color.length === 9 ? color.slice(0, 7) : color);

  const handlePaletteColorChange = (color: PaletteColorKey, value: string) => {
    onChangePaletteColor(color, value);
  };

  const iconBackColorOpen = theme.palette.mode === ThemeMode.DARK ? 'grey.200' : 'grey.300';

  return (
    <Box sx={ { flexShrink: 0, p: `${miniDrawer ? 0.75 : 0.75}` } }>
      {!miniDrawer && (
        <Grid container justifyContent="space-between" alignItems="center" sx={ { width: '100%', p: 0.5 } }>
          <Grid>
            <Stack direction="row" spacing={1.25} alignItems="center">
              <ButtonBase
                sx={ {
                  width: '100%',
                  p: 0.25,
                  bgcolor: open ? iconBackColorOpen : 'transparent',
                  borderRadius: 1,
                  '&:hover': {
                    bgcolor: theme.palette.mode === ThemeMode.DARK ? 'secondary.light' : 'secondary.lighter',
                  },
                  '&:focus-visible': {
                    outline: `2px solid ${theme.palette.secondary.dark}`,
                    outlineOffset: 2,
                  },
                } }
                aria-label="open profile"
                ref={anchorRef}
                aria-controls={open ? 'profile-grow' : undefined}
                aria-haspopup="true"
                onClick={handleToggle}
              >
                <Avatar alt="profile user" src={heroProps.imgSrc} sx={ { width: 32, height: 32 } } />
                <Stack padding={0.5}>
                  <Typography variant="h6">{heroProps.preferredUsername}</Typography>
                  <Typography variant="body2" color="textSecondary">
                    {t('applications.User', { defaultValue: 'User' })}
                  </Typography>
                </Stack>
              </ButtonBase>
            </Stack>
          </Grid>
          <Grid>
            <Stack direction="row" spacing={1.25} alignItems="center">
              {isDemoEnabled && (
                <Tooltip title={t('judo.profile.palette', { defaultValue: 'Palette' })} placement="top">
                  <IconButton
                    aria-label={t('judo.profile.palette', { defaultValue: 'Palette' })}
                    aria-controls={paletteOpen ? 'palette-settings' : undefined}
                    aria-expanded={paletteOpen}
                    aria-haspopup="true"
                    ref={paletteAnchorRef}
                    onClick={handleTogglePalette}
                  >
                    <MdiIcon path="palette-outline" sx={ { fontSize: '1.4rem' } } />
                  </IconButton>
                </Tooltip>
              )}
              <Tooltip
                title={
                  mode === ThemeMode.DARK
                    ? t('judo.profile.thememode.light', { defaultValue: 'Theme mode: light' })
                    : t('judo.profile.thememode.dark', { defaultValue: 'Theme mode: dark' })
                }
                placement="top"
              >
                <IconButton
                  aria-label={
                    mode === ThemeMode.DARK
                      ? t('judo.profile.thememode.light', { defaultValue: 'Theme mode: light' })
                      : t('judo.profile.thememode.dark', { defaultValue: 'Theme mode: dark' })
                  }
                  onClick={handleToggleThememode}
                >
                  <MdiIcon
                    path={mode === ThemeMode.DARK ? 'weather-sunny' : 'weather-night'}
                    sx={ { fontSize: '1.4rem' } }
                  />
                </IconButton>
              </Tooltip>
              {{# if application.authentication }}
                {{# if application.profilePage }}
              <Tooltip title={t('judo.profile.profile', { defaultValue: 'Profile' })} placement="top">
                <IconButton
                  aria-label={t('judo.profile.profile', { defaultValue: 'Profile' })}
                  onClick={openProfilePage}
                >
                  <MdiIcon path="cog-outline" sx={ { fontSize: '1.4rem' } } />
                </IconButton>
              </Tooltip>
              <Tooltip title={t('judo.security.logout', { defaultValue: 'Logout' })} placement="top">
                <IconButton aria-label={t('judo.security.logout', { defaultValue: 'Logout' })} onClick={doLogout}>
                  <MdiIcon path="logout" sx={ { fontSize: '1.4rem' } } />
                </IconButton>
              </Tooltip>
              {{/ if }}
            {{/ if }}
            </Stack>
          </Grid>
        </Grid>
      )}

      {miniDrawer && (
        <Grid container justifyContent="space-between" alignItems="center" sx={ { width: '100%', p: 0.5 } }>
          <Grid>
            <Stack direction="row" alignItems="center">
              <ButtonBase
                sx={ {
                  width: '100%',
                  p: 0.5,
                  bgcolor: open ? iconBackColorOpen : 'transparent',
                  // borderRadius: 1,
                  '&:hover': {
                    bgcolor: theme.palette.mode === ThemeMode.DARK ? 'secondary.light' : 'secondary.lighter',
                  },
                  '&:focus-visible': {
                    outline: `2px solid ${theme.palette.secondary.dark}`,
                    outlineOffset: 2,
                  },
                } }
                aria-label="open profile"
                ref={anchorRef}
                aria-controls={open ? 'profile-grow' : undefined}
                aria-haspopup="true"
                onClick={handleToggle}
              >
                <Stack direction="column" alignItems="center" sx={ { p: 0.5 } }>
                  <Avatar alt="profile user" src={heroProps.imgSrc} />
                  <Divider />
                </Stack>
              </ButtonBase>
            </Stack>
          </Grid>
        </Grid>
      )}
      {isDemoEnabled && (
        <Popover
          id="palette-settings"
          open={paletteOpen}
          anchorEl={paletteAnchorRef.current}
          anchorOrigin={ { vertical: 'bottom', horizontal: 'right' } }
          transformOrigin={ { vertical: 'top', horizontal: 'right' } }
          onClose={handleClosePalette}
        >
          <Box sx={ { width: 320, p: 2 } }>
            <Typography variant="h6" gutterBottom>
              {t('judo.profile.palette', { defaultValue: 'Palette' })}
            </Typography>
            <Stack spacing={1.5}>
              {paletteColors.map((color) => (
                <TextField
                  key={color.key}
                  label={color.label}
                  type="color"
                  value={getColorInputValue(color.value)}
                  onChange={(event) => handlePaletteColorChange(color.key, event.target.value)}
                  slotProps={ { inputLabel: { shrink: true } } }
                />
              ))}
              <Button variant="outlined" onClick={onResetPaletteColors}>
                {t('judo.profile.palette.reset', { defaultValue: 'Reset colors' })}
              </Button>
            </Stack>
          </Box>
        </Popover>
      )}
      <Popover
        data-testid="profile"
        open={open}
        anchorEl={anchorRef.current}
        anchorOrigin={ {
          vertical: 'top',
          horizontal: miniDrawer ? MINI_DRAWER_WIDTH : DRAWER_WIDTH / 2,
        } }
        onClose={handleClose}
      >
        <Box>
          <Paper
            sx={ {
              width: 290,
              minWidth: 240,
              maxWidth: 290,
              [theme.breakpoints.down('md')]: {
                maxWidth: 250,
              },
            } }
          >
            <ClickAwayListener onClickAway={handleClose}>
              <ProfilePopup {{# if application.authentication }}{{# if application.profilePage }}openProfilePage={openProfilePage}{{/ if }}{{/ if }} />
            </ClickAwayListener>
          </Paper>
        </Box>
      </Popover>
    </Box>
  );
};
