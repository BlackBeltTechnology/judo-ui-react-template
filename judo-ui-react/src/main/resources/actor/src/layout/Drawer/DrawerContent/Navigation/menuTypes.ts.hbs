{{> fragment.header.hbs }}

{{# each (getAllNavigationControllerActionOutputTypes application) as |class| }}
  import type { {{ classDataName class 'Stored' }} } from '~/service-runtime/data-types';
{{/ each }}

{{# if (applicationHasMenuOperations application) }}
  export type MenuPageActions = {
    {{# each application.navigationController.actions as |action| }}
      {{ simpleActionDefinitionName action.actionDefinition }}?: () => Promise<void>;
      {{# unless (actionHasInput action) }}
        post{{ firstToUpper (simpleActionDefinitionName action.actionDefinition) }}?: (
          {{# if (actionHasOutput action) }}result: {{ classDataName action.targetDataElement.output.target 'Stored' }}{{/ if }}
        ) => Promise<void>;
      {{/ unless }}
    {{/ each }}
  };
{{ else }}
  export const _ = 'placeholder';
{{/ if }}
