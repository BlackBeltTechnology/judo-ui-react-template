{{> fragment.header.hbs }}

import { NavItemType } from './NavItem';
{{# each (getMenuDialogs application) as |item| }}
  import { use{{ pageName item.target }} } from '~/dialogs/{{ pagePath item.target }}/hooks';
{{/ each }}
{{# if (applicationHasMenuOperations application) }}
  {{# each (getMenuOperationOwnerTypes application) as |item| }}
    import { {{ classDataName item 'Stored' }} } from '~/service-runtime/data-types';
  {{/ each }}
  import {
  {{# each (getAllRoutesFromMenuActions application) as |route| }}
    {{ route }},
  {{/ each }}
  } from '~/routes';
  {{# each (getAllNavigationControllerActionTargetPageOpenInDialog application) as |relatedDialog| }}
  import { use{{ pageName relatedDialog }} } from '~/dialogs/{{ pagePath relatedDialog }}/hooks';
  {{/ each }}
  import { useErrorHandler } from '~/utilities';
  import { useRuntimeService } from '~/service-runtime';
  import { useMemo } from 'react';
  import { useSnacks, useEventBus } from '~/hooks';
  import { useTranslation } from 'react-i18next';
  import { useNavigate } from 'react-router';
  import { useTrackService } from '@pandino/react-hooks';
  import { OBJECTCLASS } from '@pandino/pandino-api';
  import { MENU_ACTIONS_HOOK_INTERFACE_KEY, MenuActionsHook } from './menuCustomization';
  import { MenuPageActions } from './menuTypes';
{{/ if }}

export const useMenus = (): NavItemType[] => {
{{# if (applicationHasMenuOperations application) }}
  const handleError = useErrorHandler();
  const { showSuccessSnack, showErrorSnack } = useSnacks();
  const { publish, subscribe } = useEventBus();
  const { t } = useTranslation();
  const navigate = useNavigate();

  const { service: customActionsHook } = useTrackService<MenuActionsHook>(
    `(${OBJECTCLASS}=${MENU_ACTIONS_HOOK_INTERFACE_KEY})`,
  );
  const customActions: MenuPageActions | undefined = customActionsHook?.();

  {{# each (getAllNavigationControllerActionTargetPageOpenInDialog application) as |pageDefinition| }}
    const open{{ pageName pageDefinition }} = use{{ pageName pageDefinition }}();
  {{/ each }}
  const runtimeService = useRuntimeService();

  {{# each (getMenuDialogs application) as |item| }}
  const open{{ pageName item.target }} = use{{ pageName item.target }}();
  {{/ each }}

  {{# each application.navigationController.actions as |action| }}
    {{> (getActionTemplate action) }}
  {{/ each }}
{{/ if }}

  return [
    {{# each application.navigationController.items as |item| }}
      {{> actor/src/layout/Drawer/DrawerContent/Navigation/menu-items-recurse.fragment.hbs item=item isRoot=true }}
    {{/ each }}
  ];
};
