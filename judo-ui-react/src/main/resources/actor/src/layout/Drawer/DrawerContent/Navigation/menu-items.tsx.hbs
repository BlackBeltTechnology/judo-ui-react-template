{{> fragment.header.hbs }}

{{# each (getMenuDialogs application) as |item| }}
  import { use{{ pageName item.target }} } from '~/dialogs/{{ pagePath item.target }}/hooks';
{{/ each }}

import { NavItemType } from './NavItem';

export const useMenus = (): NavItemType[] => {
  {{# each (getMenuDialogs application) as |item| }}
  const open{{ pageName item.target }} = use{{ pageName item.target }}();
  {{/ each }}

  return [
    {{# each application.navigationController.items as |item| }}
      {{> actor/src/layout/Drawer/DrawerContent/Navigation/menu-items-recurse.fragment.hbs item=item isRoot=true }}
    {{/ each }}
  ];
};
