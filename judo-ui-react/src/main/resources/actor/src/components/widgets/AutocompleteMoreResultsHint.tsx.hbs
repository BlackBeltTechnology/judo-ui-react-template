{{> fragment.header.hbs }}

import Box from '@mui/material/Box';
import Typography from '@mui/material/Typography';
import type { FC } from 'react';
import { useTranslation } from 'react-i18next';

/**
 * Non-interactive header rendered above the option listbox of a server-paginated
 * MUI Autocomplete when the returned page has reached its limit. Advises the user
 * to narrow the search so that hidden rows become reachable.
 *
 * Sits inside the dropdown Paper (above the listbox) but is not itself a listbox
 * option, so keyboard navigation and `isOptionEqualToValue` never see it.
 */
export const AutocompleteMoreResultsHint: FC = () => {
  const { t } = useTranslation();

  return (
    <Box
      role="presentation"
      aria-hidden="true"
      sx={ {
        px: 2,
        py: 1,
        pointerEvents: 'none',
        borderBottom: 1,
        borderColor: 'divider',
      } }
    >
      <Typography
        variant="caption"
        color="text.secondary"
        sx={ { fontStyle: 'italic' } }
      >
        {t('judo.autocomplete.type-for-more-results', { defaultValue: 'Type for more results…' })}
      </Typography>
    </Box>
  );
};
