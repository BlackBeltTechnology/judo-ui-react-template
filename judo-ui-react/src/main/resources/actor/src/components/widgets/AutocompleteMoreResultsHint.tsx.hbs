import Box from '@mui/material/Box';
import Paper, { type PaperProps } from '@mui/material/Paper';
import Typography from '@mui/material/Typography';
import type { ComponentType, FC } from 'react';
import { useCallback, useRef } from 'react';
import { useTranslation } from 'react-i18next';

export const AutocompleteMoreResultsHint: FC = () => {
  const { t } = useTranslation();

  return (
    <Box
      role="presentation"
      aria-hidden="true"
      sx={ {
        px: 2,
        py: 1,
        pointerEvents: 'none',
        borderBottom: 1,
        borderColor: 'divider',
      } }
    >
      <Typography
        variant="caption"
        color="text.secondary"
        sx={ { fontStyle: 'italic' } }
      >
        {t('judo.autocomplete.type-for-more-results', { defaultValue: 'Type for more results…' })}
      </Typography>
    </Box>
  );
};

export const useAutocompleteMoreResultsHintPaper = (
  limit: number | undefined,
  optionsLength: number,
): ComponentType<PaperProps> => {
  const show = typeof limit === 'number' && limit > 0 && optionsLength >= limit;
  const showRef = useRef(show);
  showRef.current = show;
  return useCallback((paperProps: PaperProps) => (
    <Paper {...paperProps}>
      {showRef.current && <AutocompleteMoreResultsHint />}
      {paperProps.children}
    </Paper>
  ), []);
};
