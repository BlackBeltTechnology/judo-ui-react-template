import { Autocomplete } from '@mui/material';
import InputAdornment from '@mui/material/InputAdornment';
import MenuItem from '@mui/material/MenuItem';
import Grid from '@mui/material/Grid';
import TextField from '@mui/material/TextField';
import { DatePicker, DateTimePicker } from '@mui/x-date-pickers{{ getMUIPickersPlanSuffix }}';
import { FC, useCallback, useEffect, useRef, useState } from 'react';
import { Filter, FilterEnumValue, FilterType, Operation } from '~/components-api';
import { buildFilter } from '~/utilities';
import { MdiIcon } from '~/components/MdiIcon';
import { TrinaryLogicCombobox } from '~/components/widgets';

export interface SingleValueFilterComponentProps<T> {
  filters: Filter[];
  onFiltersChange: (newFilters: Filter[]) => void;
  filterType: FilterType;
  operator: Operation;
  attributeName: keyof T;
  label: string;
  col: number;
  icon?: string;
  enumValues?: Array<FilterEnumValue>;
}

export const SingleValueFilterComponent: FC<SingleValueFilterComponentProps<any>> = ({
  filters,
  onFiltersChange,
  filterType,
  operator,
  attributeName,
  label,
  col,
  icon,
  enumValues,
}) => {
  const fallbackFilter: Filter = buildFilter(filterType, operator, attributeName as string, null, label, icon);

  const [filter, setFilter] = useState<Filter>(
    filters?.find(
      (f) =>
        f.filterOption.attributeName === attributeName &&
        f.filterOption.filterType === filterType &&
        f.filterBy.operator === operator,
    ) || fallbackFilter,
  );

  const updateFilter = useCallback(
    (value: any) => {
      if (typeof value === "string" && value === '') {
        setFilter(buildFilter(filterType, operator, attributeName as string, null, label, icon, enumValues));
      } else {
        setFilter(buildFilter(filterType, operator, attributeName as string, value, label, icon, enumValues));
      }
    },
    [filterType, operator, attributeName],
  );

  useEffect(() => {
    const newArr = filters?.filter(
      (f) =>
        f.filterOption.attributeName !== filter.filterOption.attributeName ||
        f.filterOption.filterType !== filter.filterOption.filterType ||
        f.filterBy.operator !== filter.filterBy.operator,
    );
    if (filter.filterBy.value !== undefined && filter.filterBy.value !== null) {
      newArr.push(filter);
    }
    onFiltersChange(newArr);
  }, [filter]);

  const [inputValue, setInputValue] = useState<any>(() => {
    return filter.filterBy.value !== undefined ? filter.filterBy.value : null
  });
  const inputValueRef = useRef(inputValue);

  // Keep the ref updated with the latest inputValue
  useEffect(() => {
    inputValueRef.current = inputValue;
  }, [inputValue]);

  // Debounce the API call
  useEffect(() => {
    const timer = setTimeout(() => {
      // Use the ref to get the CURRENT value
      const currentValue = inputValueRef.current;
      // Make API call with latest value
      updateFilter(currentValue);
    }, 500);

    return () => clearTimeout(timer);
  }, [inputValue]); // Re-run when inputValue changes

  return (
    <Grid size={col}>
      {(() => {
        switch (filter.filterOption.filterType) {
          case FilterType.boolean:
            return (
              // Maybe this type of control can be used later
              // <FormControlLabel
              //   control={
              //     <Checkbox value={inputValue ?? 'false'} checked={inputValue ?? false} onChange={(event) => {
              //       console.log("DDDD: " + event.target.value + ' ' + inputValue);
              //       setInputValue(!(inputValue ?? false))
              //     }} />
              //   }
              //   label={filter.filterOption.label ?? filter.filterOption.attributeName}
              // />
              <TrinaryLogicCombobox
                label={filter.filterOption.label ?? filter.filterOption.attributeName}
                value={inputValue ?? null}
                onChange={(newValue: any) => setInputValue(newValue)}
                icon={filter.filterOption.icon}
              />

            );
          case FilterType.date:
            return (
              <DatePicker
                // Single-input structure, matching the modeled date inputs.
                enableAccessibleFieldDOMStructure={false}
                label={filter.filterOption.label ?? filter.filterOption.attributeName}
                value={inputValue ?? null}
                views={['year', 'month', 'day']}
                onChange={(newValue) => setInputValue(newValue)}
                slotProps={ {
                  textField: {
                    variant: 'standard',
                    InputProps: {
                      startAdornment: (
                        <InputAdornment position="start">
                          <MdiIcon path={filter.filterOption.icon ?? 'calendar_month'} />
                        </InputAdornment>
                      ),
                    },
                  },
                } }
              />
            );
          case FilterType.dateTime:
            return (
              <DateTimePicker
                // Single-input structure, matching the modeled date inputs.
                enableAccessibleFieldDOMStructure={false}
                label={filter.filterOption.label ?? filter.filterOption.attributeName}
                value={inputValue ?? null}
                ampm={false}
                ampmInClock={false}
                views={['year', 'month', 'day', 'hours', 'minutes', 'seconds']}
                onChange={(newValue) => setInputValue(newValue)}
                slotProps={ {
                  textField: {
                    variant: 'standard',
                    InputProps: {
                      startAdornment: (
                        <InputAdornment position="start">
                          <MdiIcon path={filter.filterOption.icon ?? 'calendar-range'} />
                        </InputAdornment>
                      ),
                    },
                  },
                } }
              />
            );
          case FilterType.enumeration:
            return (
              <Autocomplete
                value={inputValue ?? null}
                onChange={(_: any, newValue: { label: string; value: string | null; key: string } | null) => setInputValue(newValue?.value)}
                renderInput={ (params) => {
                  return (
                    <TextField
                      {...params}
                      label={filter.filterOption.label ?? filter.filterOption.attributeName}
                      variant="standard"
                      InputProps={ {
                        ...params.InputProps,
                        startAdornment: (
                          <InputAdornment position="start">
                            <MdiIcon path={filter.filterOption.icon ?? 'format-list-numbered'} />
                          </InputAdornment>
                        )
                      } }
                    />
                  );
                } }
                options={filter.filterOption.enumValues
                  ? filter.filterOption.enumValues?.map(item => {
                    return {
                      value: item.value,
                      key: item.value,
                      label: item.label
                    }
                  })
                  : []
                }
              />
            );
          case FilterType.numeric:
            return (
              <TextField
                label={filter.filterOption.label ?? filter.filterOption.attributeName}
                type="number"
                variant="standard"
                value={inputValue ?? ''}
                onChange={(event) => {
                  const value = event.target.value;
                  setInputValue(value === '' ? null : Number(value));
                } }
                InputProps={ {
                  startAdornment: (
                    <InputAdornment position="start">
                      <MdiIcon path={filter.filterOption.icon ?? 'numeric'} />
                    </InputAdornment>
                  ),
                } }
              />
            );
          case FilterType.string:
            return (
              <TextField
                label={filter.filterOption.label ?? filter.filterOption.attributeName}
                value={inputValue ?? ''}
                variant="standard"
                onChange={(event) => setInputValue(event.target.value)}
                InputProps={ {
                  startAdornment: (
                    <InputAdornment position="start">
                      <MdiIcon path={filter.filterOption.icon ?? 'format-size'} />
                    </InputAdornment>
                  ),
                } }
              />
            );
          case FilterType.trinaryLogic:
            return (
              <TrinaryLogicCombobox
                label={filter.filterOption.label ?? filter.filterOption.attributeName}
                value={inputValue ?? ''}
                onChange={(newValue: any) => setInputValue(newValue)}
                icon={filter.filterOption.icon}
              />
            );
        }
      })()}
    </Grid>
  );
};
