{{> fragment.header.hbs }}

import Box from "@mui/material/Box";
import Collapse from "@mui/material/Collapse";
import Grid from '@mui/material/Grid';
import { GridValidRowModel } from '@mui/x-data-grid{{ getMUIDataGridPlanSuffix }}';
import IconButton from "@mui/material/IconButton";
import { useTheme } from "@mui/material/styles";
import useMediaQuery from "@mui/material/useMediaQuery";
import { useMemo, useState } from "react";
import { useTranslation } from 'react-i18next';
import { MdiIcon } from "~/components/MdiIcon";
import { Filter, FilterOption } from '~/components-api';
import type { QueryCustomizer } from '~/services/data-api/common/QueryCustomizer';
import {
  type FiltersSerializer,
  getOperationFromFilterOperationType,
} from '~/utilities';
import { SingleValueFilterComponent } from '~/components/table/SingleValueFilterComponent';
import { filterPanelStyles } from '~/theme/extras';

interface FixedTableFiltersProps<T extends GridValidRowModel, TStored extends GridValidRowModel> {
  tableFilterOptions: FilterOption[];
  filters: Filter[];
  ownerData?: any;
  filtersSerializer: FiltersSerializer;
  onFiltersChange: (newFilters: Filter[]) => void;
  collapsible?: boolean;
  maxFirstRowCols?: number;
}

export function FixedTableFilters<T extends GridValidRowModel, TStored extends T, S extends QueryCustomizer<T>>(props: FixedTableFiltersProps<T, TStored>) {
  const { tableFilterOptions, filters, ownerData, filtersSerializer, onFiltersChange, collapsible = true, maxFirstRowCols } = props;
  const theme = useTheme();
  const { t } = useTranslation();
  const fixedTableFilterOptions = tableFilterOptions.filter((f) => f.alwaysShown);
  const [expanded, setExpanded] = useState(false);

  // Detect screen size - on md+ we can fit multiple filters, on smaller screens only one
  const isMdUp = useMediaQuery(theme.breakpoints.up('md'));

  // Calculate which filters fit in the first row based on screen size
  const { firstRowFilters, additionalFilters } = useMemo(() => {
    if (!collapsible) {
      return { firstRowFilters: fixedTableFilterOptions, additionalFilters: [] };
    }

    if (!isMdUp) {
      // On small screens, show only first filter (each takes full width)
      return {
        firstRowFilters: fixedTableFilterOptions.slice(0, 1),
        additionalFilters: fixedTableFilterOptions.slice(1),
      };
    }

    // On md+ screens, calculate based on col values (12 column grid)
    const firstRow: FilterOption[] = [];
    const additional: FilterOption[] = [];
    let currentColSum = 0;
    const availableCols = maxFirstRowCols ?? 12;

    for (const filter of fixedTableFilterOptions) {
      const filterCol = filter.col ?? 3;
      if (firstRow.length === 0 || currentColSum + filterCol <= availableCols) {
        firstRow.push(filter);
        currentColSum += filterCol;
      } else {
        additional.push(filter);
      }
    }

    return { firstRowFilters: firstRow, additionalFilters: additional };
  }, [fixedTableFilterOptions, collapsible, isMdUp, maxFirstRowCols]);

  if (fixedTableFilterOptions.length > 0) {
    return (
      <Box sx={ filterPanelStyles.container(theme) }>
        <Box sx={ { display: "flex", alignItems: "flex-start", gap: 2 } }>
          <Box sx={ filterPanelStyles.iconContainer(theme) }>
            <MdiIcon path="magnify" sx={ filterPanelStyles.icon(theme) } />
          </Box>
          <Grid container spacing={2} alignItems="flex-end" sx={ { flex: 1 } }>
            {firstRowFilters.map((f) => (
              <SingleValueFilterComponent
                key={f.id}
                attributeName={f.attributeName as keyof T}
                filterType={f.filterType}
                operator={getOperationFromFilterOperationType(f, f.defaultOperationType)}
                filters={filters}
                onFiltersChange={onFiltersChange}
                label={f.label ?? ''}
                col={f.col ?? 3}
                icon={f.icon}
                enumValues={f.enumValues}
                size="small"
              />
            ))}
          </Grid>
          {collapsible && (
            <Box sx={ filterPanelStyles.iconContainer(theme) }>
              <IconButton
                size="small"
                onClick={() => setExpanded(!expanded)}
                title={expanded ? t('judo.component.filter.collapse', { defaultValue: 'Collapse filters' }) as string : t('judo.component.filter.expand', { defaultValue: 'Expand filters' }) as string}
                sx={ filterPanelStyles.toggleButton(theme) }
              >
                <MdiIcon path={expanded ? "menu-up" : "menu-down"} sx={ filterPanelStyles.toggleButtonIcon(theme) } />
              </IconButton>
            </Box>
          )}
        </Box>
        {collapsible && (
          <Collapse in={expanded}>
            <Box sx={ { display: "flex", alignItems: "flex-end", gap: 2, mt: 2 } }>
              <Box sx={ { width: 28 } } /> {/* Spacer to align with magnify icon */}
              <Grid container spacing={2} alignItems="flex-end" sx={ { flex: 1 } }>
                {additionalFilters.map((f) => (
                  <SingleValueFilterComponent
                    key={f.id}
                    attributeName={f.attributeName as keyof T}
                    filterType={f.filterType}
                    operator={getOperationFromFilterOperationType(f, f.defaultOperationType)}
                    filters={filters}
                    onFiltersChange={onFiltersChange}
                    label={f.label ?? ''}
                    col={f.col ?? 3}
                    icon={f.icon}
                    enumValues={f.enumValues}
                    size="small"
                  />
                ))}
              </Grid>
            </Box>
          </Collapse>
        )}
      </Box>
    );
  } else {
    return (<></>)
  }
}
