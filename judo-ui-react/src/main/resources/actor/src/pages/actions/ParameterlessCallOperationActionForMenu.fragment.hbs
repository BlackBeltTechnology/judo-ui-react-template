
// ParameterlessCallOperationAction: {{ getXMIID action }}
const {{ simpleActionDefinitionName action.actionDefinition }} = async () => {
  if (customActions?.{{ simpleActionDefinitionName action.actionDefinition }}) {
    customActions.{{ simpleActionDefinitionName action.actionDefinition }}();
  } else {
  {{# with action.actionDefinition.operation as |operation| }}
    try {
      {{# if operation.isStatic }}
      {{# if operation.output }}const { data: result } = {{/ if }}await runtimeService.callOperationStatic<void, {{# if operation.output }}{{ classDataName operation.output.target 'Stored' }}{{ else }}void{{/ if }}>(
        '{{ deriveClassPath action.ownerDataElement.target }}',
        '{{ operation.name }}',
      );
      {{ else }}
      {{# if operation.output }}const { data: result } = {{/ if }}await runtimeService.callOperation<void, {{# if operation.output }}{{ classDataName operation.output.target 'Stored' }}{{ else }}void{{/ if }}>(
        '{{ deriveClassPath action.ownerDataElement.target }}',
        '{{ operation.name }}',
        {{# if page.container.table }}
          target!
        {{ else }}
          {{# if (actionShouldUseDataAsParam action) }}
            data
          {{ else }}
            {{# if action.actionDefinition.targetType }}
              target!
            {{ else }}
              data
            {{/ if }}
          {{/ if }}
        {{/ if }}
      );
      {{/ if }}
      {{> actor/src/fragments/operations/operation-primary-output-handler.fragment.hbs operation=operation action=action }}
      if (customActions?.post{{ firstToUpper (simpleActionDefinitionName action.actionDefinition) }}) {
        await customActions.post{{ firstToUpper (simpleActionDefinitionName action.actionDefinition) }}(
          {{# if operation.output }}result,{{/ if }}
        );
      } else {
        showSuccessSnack(t('judo.action.operation.success', { defaultValue: 'Operation executed successfully' }) as string);

        {{# if operation.output }}
          {{# if action.targetPageDefinition.openInDialog }}
            await open{{ pageName action.targetPageDefinition }}({
            {{# and (isPageDataElementUnmappedSingle action.targetPageDefinition) action.targetPageDefinition.container.view }}
              ownerData: produceDataAdjustedOwner(),
              data: result,
            {{ else }}
              ownerData: result,
            {{/ and }}
            });
          {{ else }}
            navigate(routeTo{{ pageName action.targetPageDefinition }}(result.__signedIdentifier));
          {{/ if }}
        {{/ if }}
      }
    } catch (error) {
      handleError(error, { actionId: '{{ getXMIID action }}' });
    }
  {{/ with }}
  }
};
