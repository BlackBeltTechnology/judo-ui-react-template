// RefreshAction: {{ getXMIID action }}
{{# if page.isSelector }}
  const {{ simpleActionDefinitionName action.actionDefinition }} = async (queryCustomizer: {{ classDataName action.targetDataElement.target 'QueryCustomizer' }}): Promise<JudoRestResponse<{{ classDataName action.targetDataElement.target 'Stored' }}[]>> => {
    {{# with (getTableParentForActionDefinition action.actionDefinition) as |table| }}
      try {
        return runtimeService.getRangeForRelation<{{ classDataName action.targetDataElement.target 'Stored' }}>('{{ deriveClassPath page.dataElement.target }}', '{{ action.targetDataElement.name }}', produceDataAdjustedOwner(), queryCustomizer{{# if table.showTotalCount }}, { [X_JUDO_COUNT_RECORDS]: 'true' }{{/ if }});
      } catch (error: any) {
        handleError(error, { actionId: '{{ getXMIID action }}' });
        return Promise.resolve({ data: [], headers: error.response?.headers, status: error.response?.status, statusText: 'fallback', config: { headers: error.response?.headers } });
      }
    {{/ with }}
  };
{{ else }}
  {{# if action.targetDataElement }}
  const {{ simpleActionDefinitionName action.actionDefinition }} = async (queryCustomizer: {{ classDataName action.targetDataElement.target 'QueryCustomizer' }}): Promise<JudoRestResponse<{{ classDataName action.targetDataElement.target 'Stored' }}{{# if action.targetDataElement.isCollection }}[]{{ else }} | null{{/ if }}>> => {
    {{# if action.targetDataElement.isCollection }}
    const result = await runtimeService.listRelation<{{ classDataName action.targetDataElement.target 'Stored' }}>('{{ deriveClassPath page.dataElement.target }}', '{{ action.targetDataElement.name }}', {{{ refreshActionDataParameter action }}}, queryCustomizer{{# with (getTableParentForActionDefinition action.actionDefinition) as |table| }}{{# if table.showTotalCount }}, { [X_JUDO_COUNT_RECORDS]: 'true' }{{/ if }}{{/ with }});
    {{ else }}
    const result = await runtimeService.getRelation<{{ classDataName action.targetDataElement.target 'Stored' }}>('{{ deriveClassPath page.dataElement.target }}', '{{ action.targetDataElement.name }}', {{{ refreshActionDataParameter action }}}, queryCustomizer);
    {{/ if }}
    {{# if page.container.view }}
      {{# if (isRefreshPageInitializer action page) }}
      if (!isDraft) {
        owner.current = result.data;
      }
      {{/ if }}
    {{/ if }}
    return result;
  }
  {{ else }}
  const {{ simpleActionDefinitionName action.actionDefinition }} = async (queryCustomizer: {{ classDataName (getReferenceClassType page) 'QueryCustomizer' }}): Promise<JudoRestResponse<{{ classDataName (getReferenceClassType page) 'Stored' }}{{# if page.container.table }}[]{{/ if }}>> => {
    try {
      setIsLoading(true);
      setEditMode(false);
      {{# if page.container.table }}
        {{# with (getTableParentForActionDefinition action.actionDefinition) as |table| }}
        {{# if (pageHasSignedId page) }}
          {{# unless page.openInDialog }}
            setRouterPageData({ __signedIdentifier: signedIdentifier } as any);
          {{/ unless }}
        {{/ if }}
        {{# if page.dataElement.isAccess }}
        return runtimeService.listActorRelation<{{ classDataName (getReferenceClassType page) 'Stored' }}>('{{ page.dataElement.name }}', {{# if (pageHasSignedId page) }}{ __signedIdentifier: signedIdentifier } as any{{ else }}{{# if page.openInDialog }}ownerData{{ else }}undefined{{/ if }}{{/ if }}, queryCustomizer{{# if table.showTotalCount }}, { [X_JUDO_COUNT_RECORDS]: 'true' }{{/ if }});
        {{ else }}
        return runtimeService.listRelation<{{ classDataName (getReferenceClassType page) 'Stored' }}>('{{ deriveTargetClassPath page.dataElement }}', '{{ page.dataElement.name }}', {{# if (pageHasSignedId page) }}{ __signedIdentifier: signedIdentifier } as any{{ else }}{{# if page.openInDialog }}ownerData{{ else }}undefined{{/ if }}{{/ if }}, queryCustomizer{{# if table.showTotalCount }}, { [X_JUDO_COUNT_RECORDS]: 'true' }{{/ if }});
        {{/ if }}
        {{/ with }}
      {{ else }}
        const response = await runtimeService.refresh<{{ classDataName (getReferenceClassType page) 'Stored' }}>('{{ deriveClassPath (getReferenceClassType page) }}', {{{ refreshActionDataParameter action }}}, getPageQueryCustomizer());
        const { data: result } = response;
        {{# if (isRefreshPageInitializer action page) }}
        if (!isDraft) {
          owner.current = result;
        }
        {{/ if }}
        setData(result);
        setLatestViewData(result);
        {{# if (pageIsRootStateOwner page) }}
          publish('{{ getXMIID page }}:refreshed', result);
        {{/ if }}
        {{# unless page.openInDialog }}
          {{# if page.container.view }}
            setRouterPageData(result);
          {{/ if }}
        {{/ unless }}
        if (customActions?.post{{ firstToUpper (simpleActionDefinitionName action.actionDefinition) }}) {
          await customActions?.post{{ firstToUpper (simpleActionDefinitionName action.actionDefinition) }}(result{{# unless page.container.table }}, storeDiff, setValidation{{/ unless }});
        }
        return response;
      {{/ if }}
    } catch (error) {
      handleError(error, { actionId: '{{ getXMIID action }}' });
      setLatestViewData(null);
      {{# unless page.openInDialog }}
        setRouterPageData(null);
      {{/ unless }}
      return Promise.reject(error);
    } finally {
      setIsLoading(false);
      {{# if page.container.view }}
      setRefreshCounter((prevCounter) => prevCounter + 1);
      {{/ if }}
    }
  };
{{/ if }}
{{/ if }}
