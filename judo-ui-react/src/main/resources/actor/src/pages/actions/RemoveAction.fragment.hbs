// RemoveAction: {{ getXMIID action }}
const {{ simpleActionDefinitionName action.actionDefinition }} = async (target: {{ classDataName action.actionDefinition.targetType 'Stored' }}) => {
  {{# with (getTableParentForActionDefinition action.actionDefinition) as |table| }}
    {{# if table.isEager }}
      const newList = (data?.{{ table.dataElement.name }} ?? []).filter((c: any) => resolveTransferId(c) !== resolveTransferId(target));
      storeDiff('{{ table.dataElement.name }}', newList);
    {{ else }}
      try {
        setIsLoading(true);
        await {{ getServiceImplForPage page }}.remove{{# if action.actionDefinition.isContainedRelationAction }}{{ firstToUpper action.targetDataElement.name }}{{/ if }}({{# if page.container.table }}{ __signedIdentifier: signedIdentifier } as any{{ else }}data{{/ if }}, [target]);
        await refresh();
      } catch(error) {
        handleError<{{ classDataName action.actionDefinition.targetType '' }}>(error, { actionId: '{{ getXMIID action }}' }, target);
      } finally {
        setIsLoading(false);
      }
    {{/ if }}
  {{/ with }}
};
