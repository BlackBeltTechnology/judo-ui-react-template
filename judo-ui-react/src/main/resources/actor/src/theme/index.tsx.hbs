type ThemeCustomizationProps = {
  children: ReactNode;
};

export function ThemeCustomization({ children }: ThemeCustomizationProps) {
  const { mode, paletteOverrides } = useConfig();
  const isDemoEnabled = useDemoFeature();

  const base = useMemo(() => {
    const palette = mode === 'light' ? paletteThemeLight.palette : paletteThemeDark.palette;
    const overrides: PaletteOverrides = isDemoEnabled ? (paletteOverrides ?? {}) : {};
    const theme = createTheme({
      palette: {
        mode: palette.mode,
        primary: { main: overrides.primary ?? palette.primary.main },
        secondary: { main: overrides.secondary ?? palette.secondary.main },
        error: { main: overrides.error ?? palette.error.main },
        warning: { main: overrides.warning ?? palette.warning.main },
        info: { main: overrides.info ?? palette.info.main },
        success: { main: overrides.success ?? palette.success.main },
        text: {
          primary: overrides.textPrimary ?? palette.text.primary,
          secondary: overrides.textSecondary ?? palette.text.secondary,
        },
        background: {
          default: overrides.backgroundDefault ?? palette.background.default,
          paper: overrides.backgroundPaper ?? palette.background.paper,
        },
        subtitleColor: { main: overrides.subtitleColor ?? palette.subtitleColor.main },
      },
    });
    return baseTheme(
      theme,
      defaultScales.scaleXs,
      defaultScales.scaleSm,
      defaultScales.scaleMd,
      defaultScales.scaleLg,
      defaultScales.scaleXl,
    );
  }, [isDemoEnabled, mode, paletteOverrides]);

  return (
    <StyledEngineProvider injectFirst>
      <ThemeProvider theme={base}>
        <CssBaseline />
        {children}
      </ThemeProvider>
    </StyledEngineProvider>
  );
}

