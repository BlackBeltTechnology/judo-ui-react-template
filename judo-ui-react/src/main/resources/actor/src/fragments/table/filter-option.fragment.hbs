{
  id: '{{ createId filter }}',
  attributeName: '{{ filter.attributeType.name }}',
  label: t('{{ getTranslationKeyForVisualElement filter }}', { defaultValue: '{{ filter.label }}' }) as string,
  filterType: FilterType.{{ getFilterTypeForFilter filter }},
  {{# if (isAttributeTypeEnumeration filter.attributeType) }}
  enumValues: [
    {{# each filter.attributeType.dataType.members as |member| }}
    { value: '{{ member.name }}', label: t('enumerations.{{ restParamName filter.attributeType.dataType }}.{{ member.name }}', { defaultValue: '{{ member.name }}' }) },
    {{/ each }}
  ],
  {{/ if }}
},
