// Record of attribute names to check with the actual value of the referenced requiredBy field's value
const requiredByRecord: Record<string, boolean> = {
  {{# each (getRequiredByWidgetsForPage page) as |child| }}
    {{# if child.attributeType }}
      {{# if child.requiredBy }}
      {{ child.attributeType.name }}: !!data.{{ child.requiredBy.name }},
      {{ else }}
      {{ child.attributeType.name }}: true,
      {{/ if }}
    {{ else }}
      {{# if child.requiredBy }}
      {{ child.relationType.name }}: !!data.{{ child.requiredBy.name }},
      {{ else }}
      {{ child.relationType.name }}: true,
      {{/ if }}
    {{/ if }}
  {{/ each }}
};

const attributesToValidateRange: (keyof {{ classDataName (getReferenceClassType page) '' }})[] = [
{{# each (getNotReadOnlyDateInputs page.container) as |child| }}
  '{{ child.attributeType.name }}',
{{/ each }}
{{# each (getNotReadOnlyDateTimeInputs page.container) as |child| }}
  '{{ child.attributeType.name }}',
{{/ each }}
{{# each (getNotReadOnlyTimeInputs page.container) as |child| }}
  '{{ child.attributeType.name }}',
{{/ each }}
{{# each (getNotReadOnlyNumericInputs page.container) as |child| }}
  '{{ child.attributeType.name }}',
{{/ each }}
];

const validationResult = passesLocalValidation<{{ classDataName (getReferenceClassType page) '' }}>(data, requiredByRecord, attributesToValidateRange, t, validation, setValidation);

if (!validationResult) {
  return;
}
