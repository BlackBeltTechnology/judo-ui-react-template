// Model Runtime Parser - Three-Pass Implementation
// Based on specification in PARSER_SPECIFICATION.md
//
// Pass 1: Index Building - Build complete @id index and derive missing eClass attributes
// Pass 2: Object Instantiation - Create implementation class instances for all indexed elements
// Pass 3: Reference Wiring - Resolve all $ref and contained object references

import type { Application } from './types';
import * as Impl from './implementations';

// Type Definitions for Parser

type ElementIndex = Map<string, any>;
type InstanceMap = Map<string, any>;
type EClassMapping = Map<string, new (data: any) => any>;

interface PropertyTypeInfo {
  eClass: string;
  isMany: boolean;
}

type MetaModelSchema = Map<string, Map<string, PropertyTypeInfo>>;

/**
 * Three-Pass Model Parser
 *
 * This parser implements a clean three-pass approach for loading EMF/Ecore-based JSON models:
 * 1. Pass 1: Build element index and derive missing eClass attributes
 * 2. Pass 2: Instantiate implementation class instances
 * 3. Pass 3: Wire all references to actual instances
 */
export class ModelParser {
  private eClassMap: EClassMapping;
  private metaModelSchema: MetaModelSchema;
  private elementIndex: ElementIndex = new Map();
  private instanceMap: InstanceMap = new Map();
  private application: Application | null = null;
  private debug: boolean = false;

  constructor(application?: Application, debug: boolean = false) {
    this.debug = debug;
    this.eClassMap = this.createEClassMapping();
    this.metaModelSchema = this.createMetaModelSchema();

    if (application) {
      this.application = application;
    }
  }

  /**
   * Parse a JSON model and return the root Application instance
   */
  parse(jsonModel: any): Application {
    if (this.debug) {
      console.log('ModelParser: Starting three-pass parsing...');
    }

    // Pass 1: Build index with type derivation
    if (this.debug) {
      console.log('Pass 1: Building element index with type derivation...');
    }
    this.elementIndex = this.buildIndex(jsonModel);
    if (this.debug) {
      console.log(`Pass 1 complete: Indexed ${this.elementIndex.size} elements`);
    }

    // Pass 2: Instantiate objects
    if (this.debug) {
      console.log('Pass 2: Instantiating objects...');
    }
    this.instanceMap = this.instantiateObjects();
    if (this.debug) {
      console.log(`Pass 2 complete: Instantiated ${this.instanceMap.size} objects`);
    }

    // Pass 3: Wire references
    if (this.debug) {
      console.log('Pass 3: Wiring references...');
    }
    this.application = this.wireReferences(jsonModel);
    if (this.debug) {
      console.log('Pass 3 complete: Model parsing finished');
    }

    if (!this.application) {
      throw new Error('Failed to parse application model');
    }

    return this.application;
  }

  /**
   * Get the loaded application
   */
  getApplication(): Application | null {
    return this.application;
  }

  /**
   * Get an instance by its @id
   */
  getInstance(id: string): any | undefined {
    return this.instanceMap.get(id);
  }

  /**
   * Get all instances of a specific type
   */
  getInstancesByType(eClass: string): any[] {
    const instances: any[] = [];
    for (const [id, instance] of this.instanceMap.entries()) {
      const element = this.elementIndex.get(id);
      if (element && element.eClass === eClass) {
        instances.push(instance);
      }
    }
    return instances;
  }

  // ============================================================================
  // Pass 1: Index Building with Type Derivation
  // ============================================================================

  /**
   * Pass 1: Build index of all elements with @id, deriving missing eClass attributes
   */
  private buildIndex(jsonModel: any): ElementIndex {
    const index = new Map<string, any>();

    const traverse = (obj: any, parentEClass?: string, propertyName?: string): void => {
      if (obj === null || typeof obj !== 'object') {
        return;
      }

      // Derive eClass if missing but parent context is available
      if (!obj['eClass'] && parentEClass && propertyName) {
        const parentSchema = this.metaModelSchema.get(parentEClass);
        if (parentSchema) {
          const propertyInfo = parentSchema.get(propertyName);
          if (propertyInfo) {
            // Add derived eClass to the object
            obj['eClass'] = propertyInfo.eClass;
            if (this.debug) {
              console.log(`Pass 1: Derived eClass ${propertyInfo.eClass} for property ${propertyName} from parent ${parentEClass}`);
            }
          }
        }
      }

      // If this object has an @id, add it to the index
      if (obj['@id']) {
        index.set(obj['@id'], obj);
        if (this.debug) {
          console.log(`Pass 1: Indexed element @id="${obj['@id']}", eClass="${obj['eClass'] || 'undefined'}"`);
        }
      }

      // Get current eClass for recursive traversal
      const currentEClass = obj['eClass'];

      // Recursively traverse all properties
      if (Array.isArray(obj)) {
        for (const item of obj) {
          traverse(item, parentEClass, propertyName);
        }
      } else {
        for (const key in obj) {
          if (key !== '$ref') { // Don't traverse into references
            traverse(obj[key], currentEClass, key);
          }
        }
      }
    };

    traverse(jsonModel);
    return index;
  }

  // ============================================================================
  // Pass 2: Object Instantiation
  // ============================================================================

  /**
   * Pass 2: Instantiate implementation class instances for all indexed elements
   */
  private instantiateObjects(): InstanceMap {
    const instances = new Map<string, any>();

    for (const [id, element] of this.elementIndex.entries()) {
      const eClass = element.eClass;

      if (!eClass) {
        if (this.debug) {
          console.warn(`Pass 2: Element ${id} has no eClass property (derivation failed in Pass 1)`);
        }
        continue;
      }

      const Constructor = this.eClassMap.get(eClass);

      if (!Constructor) {
        if (this.debug) {
          console.warn(`Pass 2: No implementation class found for eClass: ${eClass}`);
        }
        continue;
      }

      // Create instance with raw data (references not yet resolved)
      const instance = new Constructor(element);
      instances.set(id, instance);

      if (this.debug) {
        console.log(`Pass 2: Instantiated ${Constructor.name} for @id="${id}"`);
      }
    }

    return instances;
  }

  // ============================================================================
  // Pass 3: Reference Wiring
  // ============================================================================

  /**
   * Pass 3: Wire all references to actual instances
   */
  private wireReferences(jsonModel: any): any {
    // Update all instances' properties with resolved references
    for (const [id, instance] of this.instanceMap.entries()) {
      const rawElement = this.elementIndex.get(id);
      if (rawElement) {
        this.updateInstanceProperties(instance, rawElement);
      }
    }

    // Return the resolved root model
    return this.resolveValue(jsonModel);
  }

  /**
   * Update an instance's properties with resolved references
   */
  private updateInstanceProperties(instance: any, rawData: any): void {
    for (const propKey in rawData) {
      // Skip metadata properties
      if (propKey === '@id' || propKey === 'eClass') {
        continue;
      }

      const rawValue = rawData[propKey];

      // Resolve the property value
      const resolvedValue = this.resolvePropertyValue(rawValue);

      // Update the instance property
      instance[propKey] = resolvedValue;
    }
  }

  /**
   * Resolve a property value (handles nested structures)
   */
  private resolvePropertyValue(value: any): any {
    if (value === null || value === undefined) {
      return value;
    }

    // Handle arrays
    if (Array.isArray(value)) {
      return value.map(item => this.resolvePropertyValue(item));
    }

    // Handle objects
    if (typeof value === 'object') {
      // Cross-reference?
      if (value['$ref'] && value['eClass']) {
        const refId = value['$ref'];
        const instance = this.instanceMap.get(refId);
        if (instance) {
          return instance;
        }
        if (this.debug) {
          console.warn(`Pass 3: Reference not found: ${refId}`);
        }
        return value;
      }

      // Contained object with @id?
      if (value['@id']) {
        const instance = this.instanceMap.get(value['@id']);
        if (instance) {
          return instance;
        }
      }

      // Inline value object (no @id, no $ref)
      // Recursively resolve its properties
      const resolved: any = {};
      for (const key in value) {
        if (key !== '@id' && key !== 'eClass') {
          resolved[key] = this.resolvePropertyValue(value[key]);
        }
      }
      return resolved;
    }

    // Primitive value
    return value;
  }

  /**
   * Resolve a value (could be a reference, an instance, or a primitive)
   */
  private resolveValue(obj: any): any {
    if (obj === null || typeof obj !== 'object') {
      return obj;
    }

    // Case 1: Cross-reference with $ref
    if (obj['$ref'] && obj['eClass']) {
      const refId = obj['$ref'];
      const instance = this.instanceMap.get(refId);

      if (!instance) {
        if (this.debug) {
          console.warn(`Pass 3: Reference not found: ${refId}`);
        }
        return obj; // Keep original if reference can't be resolved
      }

      return instance;
    }

    // Case 2: Contained object with @id (already instantiated)
    if (obj['@id']) {
      const instance = this.instanceMap.get(obj['@id']);
      if (instance) {
        return instance;
      }
      // If not in instance map, it might be an inline object without eClass
      // Fall through to handle as regular object
    }

    // Case 3: Array - resolve each element
    if (Array.isArray(obj)) {
      return obj.map(item => this.resolveValue(item));
    }

    // Case 4: Regular object (inline, no @id)
    // This could be a value object like Size, Icon, etc.
    return obj;
  }

