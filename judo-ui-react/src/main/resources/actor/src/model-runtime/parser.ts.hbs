  operationTypesByFQName: Map<string, any>;
  pagesByContainer: Map<string, any[]>;
  pagesByDataElement: Map<string, any[]>;
  allElementsByFQName: Map<string, any>;
  visualElementsByFQName: Map<string, any>;
  actionDefinitionsByFQName: Map<string, any>;
  actionsByFQName: Map<string, any>;
}

