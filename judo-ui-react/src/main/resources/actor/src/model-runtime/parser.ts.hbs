// ============================================================================
// Factory Functions
// ============================================================================

/**
 * Create a model parser instance
 */
export function createModelParser(application?: Application, debug: boolean = false): ModelParser {
  return new ModelParser(application, debug);
}

/**
 * Parse raw JSON data into a fully typed Application with implementation instances
 */
export function parseApplicationModel(rawData: any, debug: boolean = false): Application {
  const parser = new ModelParser(undefined, debug);
  return parser.parse(rawData);
}

/**
 * Create an empty application with implementation instances
 */
export function createEmptyApplication(): Application {
  return new Impl.ApplicationImpl({
    name: '',
    fqName: '',
    pages: [],
    pageContainers: [],
    dataElements: [],
    dataTypes: [],
    mimeTypes: [],
  });
}

