}

export interface ReferenceType extends DataElement {
  target: ClassType;
  isCollection: boolean;
  isRequired?: boolean;
}

export interface StringType extends DataType {
  type: 'StringType';
  maxLength: number;
  regExp?: string;
}

export interface NumericType extends DataType {
  type: 'NumericType';
  precision: number;
  scale: number;
}

export interface BooleanType extends DataType {
