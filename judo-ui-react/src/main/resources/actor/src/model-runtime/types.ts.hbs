}

export interface DataElement extends NamedElement {
  type: 'ClassType' | 'RelationType' | 'AttributeType' | 'OperationType' | 'OperationParameterType' | 'ApplicationType';
}

export interface DataType extends NamedElement {
  type: 'StringType' | 'NumericType' | 'BooleanType' | 'DateType' | 'TimestampType' | 'TimeType' | 'EnumerationType' | 'BinaryType' | 'PasswordType';
