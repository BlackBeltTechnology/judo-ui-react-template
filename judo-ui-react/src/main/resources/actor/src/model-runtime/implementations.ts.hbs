// Base Implementation Classes

export class NamedElementImpl implements Types.NamedElement {
  name: string;
  fqName: string;
  sourceId?: string;
  annotations?: Types.Annotation[];

  constructor(data: Partial<Types.NamedElement> = {}) {
    this.name = data.name || '';
    this.fqName = data.fqName || '';
    this.sourceId = data.sourceId;
    this.annotations = data.annotations;
  }

  getSeparator(): string {
    return '.';
  }

  getFQName(): string {
    return this.fqName;
  }

  getOwner(): Types.NamedElement | undefined {
    return undefined;
  }
}

export class AnnotationImpl implements Types.Annotation {
  name: string;

  constructor(data: Partial<Types.Annotation> = {}) {
    this.name = data.name || '';
  }
}

export class IconImpl implements Types.Icon {
  iconName: string;

  constructor(data: Partial<Types.Icon> = {}) {
    this.iconName = data.iconName || '';
  }
}

