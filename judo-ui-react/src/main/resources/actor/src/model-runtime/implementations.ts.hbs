export class ApplicationImpl extends NamedElementImpl implements Types.Application {
  modelName: string;
  version: string;
  defaultLanguage: string;
  logo?: string;
  icon?: string;
  title?: string;
  backgroundImage?: string;
  supportGuestAccess: boolean;
  actor: Types.ClassType;
  principal?: Types.ClassType;
  navigationController?: Types.NavigationController;
  pages: Types.PageDefinition[];
  pageContainers: Types.PageContainer[];
  dataElements: Types.DataElement[];
  dataTypes: Types.DataType[];
  theme: Types.Theme;
  authentication?: Types.Authentication;
  defaultMenuLayout?: 'VERTICAL' | 'HORIZONTAL';

  constructor(data: Partial<Types.Application> = {}) {
    super(data);
    this.modelName = data.modelName || '';
    this.version = data.version || '1.0.0';
    this.defaultLanguage = data.defaultLanguage || 'en-US';
    this.logo = data.logo;
    this.icon = data.icon;
    this.title = data.title;
    this.backgroundImage = data.backgroundImage;
    this.supportGuestAccess = data.supportGuestAccess ?? false;
    this.actor = data.actor || new ClassTypeImpl();
    this.principal = data.principal;
    this.navigationController = data.navigationController;
    this.pages = data.pages || [];
    this.pageContainers = data.pageContainers || [];
    this.dataElements = data.dataElements || [];
    this.dataTypes = data.dataTypes || [];
    this.theme = data.theme || new ThemeImpl();
    this.authentication = data.authentication;
    this.defaultMenuLayout = data.defaultMenuLayout;
  }

  getTables(): Types.Table[] {
    const tables: Types.Table[] = [];
    const collectTables = (element: Types.VisualElement) => {
      if (element.elementType === 'Table') {
        tables.push(element as Types.Table);
      }
      if ('children' in element && Array.isArray((element as any).children)) {
        (element as any).children.forEach(collectTables);
      }
    };
    this.pageContainers.forEach((container) => collectTables(container));
    return tables;
  }

  getLinks(): Types.Link[] {
    const links: Types.Link[] = [];
    const collectLinks = (element: Types.VisualElement) => {
      if (element.elementType === 'Link') {
        links.push(element as Types.Link);
      }
      if ('children' in element && Array.isArray((element as any).children)) {
        (element as any).children.forEach(collectLinks);
      }
    };
    this.pageContainers.forEach((container) => collectLinks(container));
    return links;
  }

  getButtons(): Types.Button[] {
    const buttons: Types.Button[] = [];
    const collectButtons = (element: Types.VisualElement) => {
      if (element.elementType === 'Button') {
        buttons.push(element as Types.Button);
      }
      if (element.elementType === 'ButtonGroup') {
        buttons.push(...(element as Types.ButtonGroup).buttons);
      }
      if ('children' in element && Array.isArray((element as any).children)) {
        (element as any).children.forEach(collectButtons);
      }
    };
    this.pageContainers.forEach((container) => collectButtons(container));
    return buttons;
  }
}

