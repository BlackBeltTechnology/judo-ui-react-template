  const toolBarActions: ToolBarActionProps<ViewGalaxyStored>[] = [
    {
      name: 'filterAction',
      id: 'God/(esm/_YT0hQE7rEeycO-gUAWxcVg)/TransferObjectTableTableFilterButton',
      startIcon: 'filter',
      variant: 'text',
      hiddenBy: false,
      label: { translationKey: 'judo.action.filter', defaultValue: 'Set Filters' },
      enabled: (
