      if (props.row && rowValidation.current.has(resolveTransferId(props.row))) {
        const errors = rowValidation.current.get(resolveTransferId(props.row));
        error = errors?.get('discovered');
      }
      return <CellEditInput {...props} error={error} cellEditorType={'date'} />;
    },
    filterable: true && true,
    valueFormatter: (value?: Date) => {
      return (
        value &&
        new Intl.DateTimeFormat(l10nLocale, {
          year: 'numeric',
          month: '2-digit',
          day: '2-digit',
          hour: '2-digit',
          minute: '2-digit',
          second: '2-digit',
          hour12: false,
        }).format(value)
      );
    },
    filterOperators: dateTimeColumnOperators,
  };

  const columns = useMemo<GridColDef<ViewGalaxyStored>[]>(
    () => [
      nameColumn,
      realColumn,
      constellationColumn,
      magnitudeColumn,
      nakedEyeColumn,
      darkMatterColumn,
