                                    <FormControlLabel
                                      className="checkbox"
                                      sx={{
                                        marginTop: '6px',
                                        color: (theme) =>
                                          validation.has('nakedEye') ? theme.palette.error.main : 'primary',
                                      }}
                                      disabled={
