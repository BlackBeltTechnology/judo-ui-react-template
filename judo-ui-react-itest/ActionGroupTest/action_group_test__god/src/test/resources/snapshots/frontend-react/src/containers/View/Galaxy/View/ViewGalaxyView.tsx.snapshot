                        data-name="group_2"
                        size={{ xs: 12, sm: 12, md: 6.0 }}
                      >
                        <Accordion
                          data-testid={buildFieldTestId('_Emq50E7uEeycO-gUAWxcVg', 'container')}
                          data-name="group_2"
                          defaultExpanded
                        >
                          <AccordionSummary expandIcon={<ExpandMoreIcon />} sx={{ px: 3 }}>
                            <Grid
                              container
                              direction="row"
                              alignItems="center"
                              justifyContent="space-between"
                              sx={{ width: '100%', mr: 2 }}
                            >
                              <Grid>
                                <Grid container direction="row" alignItems="center" justifyContent="flex-start">
                                  <MdiIcon path="flare" sx={{ marginRight: 1 }} />
                                  <Typography variant="h6" component="h2">
                                    {t('View.Galaxy.View.group_2', { defaultValue: 'About' })}
                                  </Typography>
                                </Grid>
                              </Grid>
                            </Grid>
                          </AccordionSummary>
                          <AccordionDetails sx={{ px: 3 }}>
                            <Stack spacing={2} className="force-full-width">
                              <Grid
                                data-testid={buildFieldTestId('_YJOJEFjWEeyV2_3ibolaNQ')}
                                data-name="group"
                                size={{ xs: 12, sm: 12 }}
                              >
                                <Grid container direction="row" spacing={2}>
                                  <Grid size={{ xs: 12, sm: 12 }}>
                                    <Grid
                                      data-testid={buildFieldTestId('_YJOJEFjWEeyV2_3ibolaNQ', 'container')}
                                      data-name="group"
                                      container
                                      alignItems="stretch"
                                      justifyContent="flex-start"
                                      spacing={2}
                                    >
                                      <Grid size={{ xs: 12, sm: 12, md: 8.0 }}>
                                        <DebouncedTextField
                                          required={
                                            actions?.isNameRequired ? actions.isNameRequired(data, editMode) : true
                                          }
                                          name="name"
                                          data-testid={buildFieldTestId('_8Ad5AE7tEeycO-gUAWxcVg')}
                                          label={t('View.Galaxy.View.name', { defaultValue: 'Name' }) as string}
                                          value={data.name ?? ''}
                                          className={clsx({
                                            'JUDO-viewMode': !editMode,
                                            'JUDO-required': true,
                                          })}
                                          disabled={
